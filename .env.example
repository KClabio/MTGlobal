PORT=3000
MONGO_URI=mongodb://localhost:27017/mtglobal_db
# Signs the login cookies: 32 or more random characters, different on each server, never shared.
# On the live server the site refuses to start when this is missing, still this example value, or too short.
SESSION_SECRET=change-this-to-a-random-secret
# Only on the live server: NODE_ENV=production (turns on the checks above and the HTTPS-only browser rules).
NODE_ENV=

# Only set when running behind a real reverse proxy (Nginx/Render/Vercel...)
# The website's public address, used in sitemap.xml and robots.txt (e.g. https://mtg.vn, no slash at the end).
# Leave blank on your own computer: the address you open the site with is used.
SITE_URL=
# On the live host behind HTTPS: TRUST_PROXY=1 (one proxy in front of the site). Leave blank on your own computer.
TRUST_PROXY=
# true on the live host: the login cookie is then only sent over HTTPS (needs TRUST_PROXY above).
# Leave blank on your own computer (http://localhost), or logging in won't work there.
SESSION_COOKIE_SECURE=

# Optional in dev: leave blank to store uploads on local disk under public/uploads.
# Required in production on platforms with ephemeral disks (Render/Railway/Heroku/Vercel...).
# Create a free account at cloudinary.com and copy these 3 values from the Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: "Đăng nhập bằng Google" (README → "Log in with Google"). Leave blank to hide the button.
# From Google Cloud Console → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if Google must send visitors back to a fixed address (default: this site's own /dang-nhap/google/callback)
GOOGLE_REDIRECT_URL=
