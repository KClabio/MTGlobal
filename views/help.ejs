<%- include('partials/header', { title: t('help.title') + ' - MTG', bannerKey: 'help' }) %>

<%- include('partials/page-banner', { pill: 'MTG', heading: t('help.title'), bannerKey: 'help' }) %>

<% const helpIcon = function (inner, size) {
  return '<svg width="' + size + '" height="' + size + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">' + inner + '</svg>';
}; %>

<section class="section help-page">
  <div class="container">
    <% if (groups.length) { %>
      <%- include('partials/card-search', { placeholder: t('help.search'), one: t('help.resultsOne'), many: t('help.resultsCount'), none: t('help.noResults') }) %>

      <%# One tile per group: jumps to its questions below %>
      <nav class="help-topics" aria-label="<%= t('help.topicsLabel') %>">
        <% groups.forEach(function (g) { %>
          <a class="help-topic" href="#<%= g.key %>">
            <span class="help-topic-icon"><%- helpIcon(g.icon, 22) %></span>
            <span class="help-topic-name"><%= t(g.labelKey) %></span>
            <span class="help-topic-count"><%= t('help.questionCount', { n: g.items.length }) %></span>
          </a>
        <% }) %>
      </nav>

      <% groups.forEach(function (g) { %>
        <section class="help-group" id="<%= g.key %>" data-search-group aria-labelledby="help-title-<%= g.key %>">
          <h2 class="help-group-title" id="help-title-<%= g.key %>">
            <span class="help-group-icon"><%- helpIcon(g.icon, 20) %></span>
            <%= t(g.labelKey) %>
            <span class="help-group-count" data-search-group-count><%= g.items.length %></span>
          </h2>
          <div class="faq-list">
            <% g.items.forEach(function (it) { %>
              <%# Search looks at the question and answer in both languages; /ho-tro#q-<id> opens this one (main.js) %>
              <details class="faq-item" id="q-<%= it._id %>" data-search-item
                       data-search="<%= [it.questionVi, it.questionEn, it.answerVi, it.answerEn].filter(Boolean).join(' ') %>">
                <summary><%= pick(it, 'question') %></summary>
                <div class="prose-text prose-text-start"><%- formatText(pick(it, 'answer')) %></div>
              </details>
            <% }) %>
          </div>
        </section>
      <% }) %>
      <p class="empty-note search-none" data-search-none hidden></p>
    <% } else { %>
      <p class="empty-note"><%= t('help.empty') %></p>
    <% } %>

    <%# Still stuck: phone and email from Thông tin công ty, and the request form %>
    <% const contact = (settings && settings.contactInfo) || {}; %>
    <div class="cta-band help-cta">
      <div class="cta-band-text">
        <h2><%= t('help.ctaTitle') %></h2>
        <p><%= t('help.ctaText') %></p>
      </div>
      <div class="cta-band-actions">
        <% if (contact.phone) { %><a class="btn cta-band-btn help-cta-plain" href="tel:<%= contact.phone.replace(/[^\d+]/g, '') %>"><%- helpIcon('<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>', 17) %> <%= contact.phone %></a><% } %>
        <% if (contact.email) { %><a class="btn cta-band-btn help-cta-plain" href="mailto:<%= contact.email %>"><%- helpIcon('<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>', 17) %> <%= contact.email %></a><% } %>
        <a class="btn cta-band-btn" href="/lien-he"><%= t('help.ctaButton') %> <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
