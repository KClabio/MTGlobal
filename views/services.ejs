<%- include('partials/header', { title: t('nav.services') + ' - MTG' }) %>

<%- include('partials/page-banner', {
  pill: t('nav.services'),
  heading: t('nav.services'),
  bannerKey: 'services'
}) %>

<%# Dịch vụ landing page: one card per service (lib/home-domains.js → buildServiceCards), then the consultation band %>
<section class="section">
  <div class="container">
    <div class="card-grid cols-2 service-cards">
      <% cards.forEach(function (card) { %>
        <a class="card accent-<%= card.accent %>" href="<%= card.url %>">
          <div class="card-media<%= card.contain ? ' is-contain' : '' %><%= card.image ? '' : ' is-art' %>">
            <% if (card.image) { %>
              <%- picture(card.image, card.title, { sizes: '(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 380px' }) %>
            <% } else { %>
              <%- include('admin/partials/icon', { name: card.icon, size: 72 }) %>
            <% } %>
          </div>
          <div class="card-body">
            <h3><%= card.title %></h3>
            <% if (card.text) { %><p><%= card.text %></p><% } %>
            <span class="card-more-link"><%= t('common.learnMore') %> →</span>
          </div>
        </a>
      <% }) %>
    </div>
    <% if (!cards.length) { %><p class="empty-note"><%= t('servicesPage.empty') %></p><% } %>
    <div class="services-cta">
      <%- include('partials/cta-band', { heading: t('servicesPage.ctaTitle'), text: t('servicesPage.ctaText'), buttons: [{ url: '/lien-he', title: t('nextSteps.ctaButton') }] }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
