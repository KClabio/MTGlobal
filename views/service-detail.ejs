<%
  // The main picture in the page's language (an English poster on the English page), else the Vietnamese one
  const heroPicture = (lang === 'en' && service.heroImageEn) || service.heroImage || null;
%>
<%- include('partials/header', { title: pick(service, 'title') + ' - MTG', description: pick(service, 'summary') || pick(service, 'body'), image: heroPicture, bannerKey: 'services' }) %>

<%- include('partials/page-banner', {
  pill: t('nav.services'),
  heading: pick(service, 'title'),
  subheading: pick(service, 'summary'),
  bannerKey: 'services'
}) %>

<%
  // Each extra section only appears once an admin has given it content
  const steps = service.steps || [];
  const packages = service.packages || [];
  const faqs = service.faqs || [];
  const gallery = service.gallery || [];
  const testimonials = service.testimonials || [];
  const cards = service.cards || [];
  const features = (p) => (lang === 'en' && p.featuresEn && p.featuresEn.length ? p.featuresEn : p.featuresVi) || [];
  const cardItems = (c) => (lang === 'en' && c.itemsEn && c.itemsEn.length ? c.itemsEn : c.itemsVi) || [];
  const TONES = ['blue', 'green', 'orange', 'violet', 'teal'];
%>

<section class="section">
  <div class="container admin-form-grid service-layout">
    <div>
      <% if (heroPicture) { %>
        <%# Shown whole (often a poster with text), large enough to read, so it doesn't open larger %>
        <figure class="service-hero">
          <div class="service-hero-media">
            <%- picture(heroPicture, pick(service, 'title'), { sizes: '(max-width: 900px) 100vw, 680px', eager: true, width: 1200 }) %>
          </div>
        </figure>
      <% } %>
      <div class="prose-text prose-text-start"><%- formatText(pick(service, 'body')) %></div>

      <% if (cards.length) { %>
        <div class="service-section">
          <h2><%= pick(service, 'cardsTitle') || t('services.cardsTitle') %></h2>
          <div class="profile-cards">
            <% cards.forEach(function (c, i) { %>
              <div class="profile-card tone-<%= TONES[i % TONES.length] %>">
                <div class="profile-card-head">
                  <span class="profile-card-icon" aria-hidden="true"><%- include('admin/partials/icon', { name: c.icon || 'check-circle', size: 22 }) %></span>
                  <h3><%= pick(c, 'title') %></h3>
                </div>
                <% if (cardItems(c).length) { %>
                  <ul class="profile-card-list">
                    <% cardItems(c).forEach(function (item) { %><li><%= item %></li><% }) %>
                  </ul>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (steps.length) { %>
        <div class="service-section">
          <h2><%= pick(service, 'stepsTitle') || t('services.stepsTitle') %></h2>
          <%# The Giải pháp process trail, always running down: numbered stops on one line with arrows; main.js fills the
              line from stop to stop when it scrolls into view %>
          <ol class="process-trail is-vertical" style="--steps:<%= steps.length %>;">
            <% steps.forEach(function (s, i) { %>
              <li class="trail-step" style="--i:<%= i %>;">
                <span class="trail-node" aria-hidden="true"><%= i + 1 %></span>
                <div class="trail-body">
                  <h3><%= pick(s, 'title') %></h3>
                  <% if (pick(s, 'text')) { %><div class="card-text"><%- formatText(pick(s, 'text')) %></div><% } %>
                </div>
              </li>
            <% }) %>
          </ol>
        </div>
      <% } %>

      <% if (packages.length) { %>
        <div class="service-section">
          <h2><%= t('services.packagesTitle') %></h2>
          <div class="package-grid">
            <% packages.forEach(function (p, i) { %>
              <div class="package-card<%= p.highlighted ? ' is-highlighted' : '' %>">
                <% if (p.highlighted) { %><span class="package-badge"><%= t('services.popular') %></span><% } %>
                <h3><%= pick(p, 'name') %></h3>
                <% if (pick(p, 'price')) { %><p class="package-price"><%= pick(p, 'price') %></p><% } %>
                <% if (features(p).length) { %>
                  <ul class="package-features">
                    <% features(p).forEach(function (f) { %><li><%= f %></li><% }) %>
                  </ul>
                <% } %>
                <a class="btn <%= p.highlighted ? 'btn-primary' : 'btn-ghost' %> btn-block" href="#yeu-cau" data-choose-package="<%= i %>"><%= t('services.choosePackage') %></a>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (faqs.length) { %>
        <div class="service-section">
          <h2><%= t('services.faqTitle') %></h2>
          <div class="faq-list">
            <% faqs.forEach(function (f) { %>
              <details class="faq-item">
                <summary><%= pick(f, 'question') %></summary>
                <div class="prose-text prose-text-start"><%- formatText(pick(f, 'answer')) %></div>
              </details>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (gallery.length) { %>
        <div class="service-section">
          <h2><%= t('services.galleryTitle') %></h2>
          <div class="service-gallery">
            <% gallery.forEach(function (img) { %>
              <a href="<%= img %>" target="_blank" rel="noopener"><%- picture(img, pick(service, 'title'), { sizes: '(max-width: 640px) 50vw, 300px' }) %></a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (testimonials.length) { %>
        <div class="service-section">
          <h2><%= t('services.testimonialsTitle') %></h2>
          <div class="testimonial-grid">
            <% testimonials.forEach(function (q) { %>
              <figure class="testimonial-card">
                <blockquote><%- formatText(pick(q, 'quote')) %></blockquote>
                <% if (q.author || q.role) { %>
                  <figcaption><strong><%= q.author %></strong><% if (q.role) { %><span><%= q.role %></span><% } %></figcaption>
                <% } %>
              </figure>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>

    <aside id="yeu-cau" class="service-aside">
      <%- include('partials/quote-form', {
        actionUrl: '/dich-vu/' + service.slug + '/yeu-cau',
        fixedInterest: service.slug,
        serviceQuestions: service.questions || [],
        servicePackages: packages,
        compact: true,
        backHref: '/dich-vu/' + service.slug + '#yeu-cau',
        sent: typeof sent !== 'undefined' && sent,
        error: typeof error !== 'undefined' ? error : null,
        errors: typeof errors !== 'undefined' ? errors : {},
        values: typeof values !== 'undefined' ? values : {},
      }) %>
    </aside>
  </div>
</section>

<%- include('partials/footer') %>
