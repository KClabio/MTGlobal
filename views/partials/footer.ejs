  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <div class="logo"><%- include('logo') %></div>
        <p class="footer-company"><%= lang === 'en' ? 'Mễ Trì Global Technology Co., Ltd' : 'Công ty TNHH Công nghệ Mễ Trì Global' %></p>
        <%# Mã số doanh nghiệp (Admin → Thông tin công ty), with where/when it was issued; nothing while empty %>
        <% const ftReg = (settings && settings.contactInfo) || {}; %>
        <% if (ftReg.taxCode) { %>
          <p class="footer-tax" data-footer-tax><%= t('footer.taxCode') %>: <%= ftReg.taxCode %><% if (ftReg.registration) { %>, <%= ftReg.registration %><% } %></p>
        <% } %>
        <p class="footer-about">
          <%= lang === 'en'
            ? 'Smart robotics, STEM Lab solutions, and technology consulting services.'
            : 'Robot thông minh, giải pháp phòng Lab STEM và các dịch vụ tư vấn công nghệ.' %>
        </p>
      </div>

      <div class="footer-col">
        <h2 class="footer-title"><%= t('footer.quickLinks') %></h2>
        <a href="/san-pham"><%= t('nav.products') %></a>
        <a href="/giai-phap"><%= t('nav.solutions') %></a>
        <a href="/dich-vu"><%= t('nav.services') %></a>
        <a href="/tin-tuc"><%= t('nav.news') %></a>
        <a href="/ve-mtg"><%= t('nav.about') %></a>
      </div>

      <div class="footer-col">
        <h2 class="footer-title"><%= t('footer.contactInfo') %></h2>
        <% if (settings && settings.contactInfo && settings.contactInfo.address) { %>
          <p><%= settings.contactInfo.address %></p>
        <% } %>
        <% if (settings && settings.contactInfo && settings.contactInfo.phone) { %>
          <a href="tel:<%= settings.contactInfo.phone %>"><%= settings.contactInfo.phone %></a>
        <% } %>
        <% if (settings && settings.contactInfo && settings.contactInfo.email) { %>
          <a href="mailto:<%= settings.contactInfo.email %>"><%= settings.contactInfo.email %></a>
        <% } %>
        <% chatLinks(settings && settings.contactInfo).forEach(function (l) { %>
          <a href="<%= l.url %>" target="_blank" rel="noopener" data-footer-chat="<%= l.kind %>"><%= t('chat.' + l.kind) %></a>
        <% }) %>
        <a href="/lien-he"><%= t('common.contactUs') %></a>
        <a href="/ho-tro"><%= t('nav.help') %></a>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="container">
        &copy; <%= new Date().getFullYear() %> MTG — Mễ Trì Global. <%= t('common.allRightsReserved') %>.
        <a class="footer-bottom-link" href="/chinh-sach-bao-mat"><%= t('privacy.title') %></a>
        <a class="footer-bottom-link" href="/dieu-khoan-su-dung"><%= t('terms.title') %></a>
      </div>
    </div>
  </footer>

  <%- include('chat-button') %>

  <% if (typeof loginNotice !== 'undefined' && loginNotice) { %>
    <%# Shown once after logging in; public/js/main.js hides it after a few seconds (CSS fades it out without JS) %>
    <% const toastJoined = typeof googleJoinedNotice !== 'undefined' && googleJoinedNotice; %>
    <div class="site-toast" role="status" aria-live="polite" data-site-toast<%- toastJoined ? ' data-toast-long' : '' %>>
      <span class="site-toast-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M20 6 9 17l-5-5"/></svg></span>
      <span class="site-toast-text"><strong><%= t('auth.loginDone') %></strong> <%= t('auth.loginHello', { name: loginNotice }) %><% if (toastJoined) { %> <%= t('auth.googleJoined') %><% } %></span>
      <button type="button" class="site-toast-x" data-site-toast-close aria-label="<%= t('auth.closeNotice') %>" title="<%= t('auth.closeNotice') %>">×</button>
    </div>
  <% } else if (typeof deletedNotice !== 'undefined' && deletedNotice) { %>
    <div class="site-toast" role="status" aria-live="polite" data-site-toast data-deleted-notice>
      <span class="site-toast-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M20 6 9 17l-5-5"/></svg></span>
      <span class="site-toast-text"><strong><%= t('privacy.deleted') %></strong> <%= t('privacy.deletedText') %></span>
      <button type="button" class="site-toast-x" data-site-toast-close aria-label="<%= t('auth.closeNotice') %>" title="<%= t('auth.closeNotice') %>">×</button>
    </div>
  <% } %>
  <script src="<%= asset('/js/theme.js') %>"></script>
  <script src="<%= asset('/js/main.js') %>"></script>
  <div id="page-end" hidden></div>
</body>
</html>
