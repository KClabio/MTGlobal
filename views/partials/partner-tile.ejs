<%# Each logo opens the partner's own page on this site (/doi-tac/<slug>); that page has the button to the partner's website %>
<div class="partner-tile">
  <% if (partner.slug) { %>
    <a href="/doi-tac/<%= partner.slug %>" title="<%= t('home.partnerView', { name: partner.name }) %>"><img src="<%= partner.logo %>" alt="<%= t('home.partnerView', { name: partner.name }) %>" loading="lazy"></a>
  <% } else { %>
    <img src="<%= partner.logo %>" alt="<%= partner.name %>" loading="lazy">
  <% } %>
</div>
