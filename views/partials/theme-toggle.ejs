<%
  // Light/dark switch, shared by the website and the admin. The preference lives in the "theme" cookie.
  // Params: label (accessible name, shown unless compact), compact (icon-only switch for the header)
  const ttDark = typeof theme !== 'undefined' && theme === 'dark';
  const ttCompact = typeof compact !== 'undefined' && compact;
%>
<button type="button" class="theme-toggle<%= ttCompact ? ' theme-toggle--compact' : '' %>" role="switch" aria-checked="<%= ttDark %>" data-theme-toggle aria-label="<%= label %>"<% if (ttCompact) { %> title="<%= label %>"<% } %>>
  <% if (!ttCompact) { %><span class="theme-toggle-label"><%= label %></span><% } %>
  <span class="theme-toggle-track" aria-hidden="true">
    <span class="theme-toggle-thumb">
      <svg class="tt-sun" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="tt-moon" viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"/></svg>
    </span>
  </span>
</button>
