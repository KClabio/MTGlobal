<a class="card" href="/san-pham/<%= product.category %>">
  <div class="card-media">
    <% if (product.comingSoon) { %><div class="coming-soon-overlay"><span class="coming-soon-badge"><%= t('common.comingSoon') %></span></div><% } %>
    <% if (product.images && product.images[0]) { %>
      <img src="<%= product.images[0] %>" alt="<%= pick(product, 'name') %>" loading="lazy">
    <% } %>
  </div>
  <div class="card-body">
    <h3><%= pick(product, 'name') %></h3>
    <p><%= excerpt(pick(product, 'description'), 90) %></p>
    <div class="card-foot"><span class="btn btn-ghost btn-sm"><%= t('common.viewDetails') %></span></div>
  </div>
</a>
