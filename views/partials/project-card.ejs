<%# Reference project card. The project names are much alike, so the card leads with the school; without a school it shows the project name. %>
<%
  const pcTitle = pick(project, 'title');
  const pcHeading = project.schoolName || pcTitle;
  const pcSub = [project.schoolName ? pcTitle : '', project.location].filter(Boolean).join(' — ');
%>
<a class="card" href="/giai-phap/du-an/<%= project._id %>" data-search-item data-search="<%= [project.schoolName, project.location].filter(Boolean).join(' ') %>">
  <div class="card-media">
    <% if (project.images && project.images[0]) { %>
      <%- picture(project.images[0], pcHeading, { sizes: '(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 380px', eager: typeof eager !== 'undefined' && eager }) %>
    <% } %>
  </div>
  <div class="card-body">
    <h3><%= pcHeading %></h3>
    <% if (pcSub) { %><p><%= pcSub %></p><% } %>
  </div>
</a>
