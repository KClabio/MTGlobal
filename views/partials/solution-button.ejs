<%# One button of a Giải pháp page (partials/solution-section.ejs). A link to another website opens in a new tab. %><% const sbExternal = /^https?:\/\//i.test(it.url); %><a class="btn <%= it.primary ? 'btn-primary' : 'btn-ghost' %>" href="<%= it.url %>"<% if (sbExternal) { %> target="_blank" rel="noopener"<% } %>><%= pick(it, 'title') %><% if (sbExternal) { %> <span aria-hidden="true">↗</span><span class="sr-only"> <%= t('solutionPage.newTab') %></span><% } %></a>
