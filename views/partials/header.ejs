<%
  const pageTitle = typeof title !== 'undefined' ? title : 'MTG - Smart Solutions for Life';
  // Description and link preview (lib/seo.js): the page's own text and picture, else its banner line and photo (a text under 50 characters is skipped)
  // (lib/banners.js), else the site's; account and error pages ask search engines to leave them out (noindex)
  const hdSettings = typeof settings !== 'undefined' ? settings : null;
  const hdBanner = typeof bannerKey !== 'undefined' && bannerKey ? bannerFor(hdSettings, bannerKey, lang) : { subtitle: '', image: null };
  const hdHero = hdSettings && hdSettings.heroImages && hdSettings.heroImages.home;
  const meta = typeof siteBase !== 'undefined' ? pageMeta({
    base: siteBase, path: pagePath, lang,
    description: [typeof description !== 'undefined' && description, hdBanner.subtitle],
    fallbackDescription: t('seo.defaultDescription'),
    image: (typeof image !== 'undefined' && image) || hdBanner.image || hdHero,
    type: typeof ogType !== 'undefined' ? ogType : 'website',
  }) : null;
  const hdNoindex = typeof noindex !== 'undefined' && noindex;
%>
<!doctype html>
<% const langFade = typeof langSwitched !== 'undefined' && langSwitched; %>
<% const hdHomeHero = typeof homeHero !== 'undefined' && homeHero; /* Trang chủ: its photo reaches up behind the menu bar (layout.css) */ %>
<html lang="<%= lang %>" data-theme="<%= theme %>"<%- langFade ? ' class="lang-fading"' : '' %><% if (hdHomeHero) { %> data-page="home"<% } %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= searchTitle(pageTitle) %></title>
  <% if (hdNoindex) { %>
  <meta name="robots" content="noindex">
  <% } else if (meta) { %>
  <meta name="description" content="<%= meta.description %>">
  <link rel="canonical" href="<%= meta.url %>">
  <link rel="alternate" hreflang="vi" href="<%= meta.alternates.vi %>">
  <link rel="alternate" hreflang="en" href="<%= meta.alternates.en %>">
  <link rel="alternate" hreflang="x-default" href="<%= meta.alternates.vi %>">
  <meta property="og:site_name" content="<%= t('seo.siteName') %>">
  <meta property="og:type" content="<%= meta.type %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= meta.description %>">
  <meta property="og:url" content="<%= meta.url %>">
  <meta property="og:image" content="<%= meta.image %>">
  <meta property="og:image:alt" content="<%= pageTitle %>">
  <meta property="og:locale" content="<%= meta.locale %>">
  <meta property="og:locale:alternate" content="<%= meta.altLocale %>">
  <meta name="twitter:card" content="summary_large_image">
  <%# For Google (lib/structured-data.js): the company on Trang chủ, the breadcrumbs on other pages %>
  <% structuredData({ base: siteBase, path: pagePath, lang, t, settings: hdSettings || {}, pageTitle, noindex: hdNoindex }).forEach(function (block) { %>
  <script type="application/ld+json" nonce="<%= cspNonce %>"><%- jsonForScript(block) %></script>
  <% }) %>
  <% } %>
  <%# The font comes from this site (public/fonts); the regular Vietnamese/Latin weights load first %>
  <link rel="preload" href="/fonts/be-vietnam-pro-400-vietnamese.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/be-vietnam-pro-400-latin.woff2" as="font" type="font/woff2" crossorigin>
  <%# All website styles joined into one file (lib/assets.js: fonts, theme, base, layout, components, home, pages) %>
  <link rel="stylesheet" href="<%= asset('/css/site.css') %>">
  <link rel="icon" href="/images/icon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/images/icon-180.png">
  <%# A link clicked while the VI / EN fade was still running: the browser drops the fade and reports it as a failed
      promise, on the page being left and on the next one. Nothing is wrong for the visitor, so it is kept out of the
      console. This must listen from the <head>: a normal page can be shown (pagereveal) before main.js has loaded. %>
  <script nonce="<%= cspNonce %>">document.documentElement.classList.add('js');
    (function () { var quiet = function (e) { var vt = e.viewTransition; if (vt) [vt.ready, vt.finished, vt.updateCallbackDone].forEach(function (p) { if (p) p.catch(function () {}); }); };
      addEventListener('pagereveal', quiet); addEventListener('pageswap', quiet); })();</script>
  <% if (langFade) { %>
    <%# Opened from the VI / EN switch: the old page fades into this one (both pages must ask for it, main.js does it on the old one).
        The page is shown only once its scripts have run (#page-end), so the reading position is already restored. %>
    <style data-lang-fade>@view-transition { navigation: auto; }</style>
    <link rel="expect" href="#page-end" blocking="render">
  <% } %>
</head>
<body>
  <div class="brand-bar"></div>
  <header class="site-header<%= user ? '' : ' is-guest' %><%= hdHomeHero ? ' is-over-hero' : '' %>" id="siteHeader">
    <div class="container header-inner">
      <a href="/" class="logo"><%- include('logo') %></a>

      <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false" aria-controls="mainNav"><span></span><span></span><span></span></button>

      <nav class="main-nav" id="mainNav">
        <a href="/"><%= t('nav.home') %></a>

        <div class="nav-dropdown">
          <a class="nav-dropdown-trigger" href="/san-pham" aria-haspopup="true" aria-expanded="false"><%= t('nav.products') %> <span class="nav-caret" aria-hidden="true">▾</span></a>
          <div class="nav-dropdown-menu">
            <a href="/san-pham/robot-leo-cau-thang"><%= t('nav.productStairRobot') %></a>
            <a href="/san-pham/robot-di-theo-nguoi"><%= t('nav.productFollowRobot') %></a>
            <a href="/san-pham/robot-cat-co"><%= t('nav.productLawnRobot') %></a>
            <a href="/san-pham/robot-gia-dinh"><%= t('nav.productHomeRobot') %></a>
          </div>
        </div>

        <div class="nav-dropdown">
          <a class="nav-dropdown-trigger" href="/giai-phap" aria-haspopup="true" aria-expanded="false"><%= t('nav.solutions') %> <span class="nav-caret" aria-hidden="true">▾</span></a>
          <div class="nav-dropdown-menu">
            <a href="/giai-phap/stem-lab"><%= t('nav.solutionOverview') %></a>
            <a href="/giai-phap/thiet-bi"><%= t('nav.solutionEquipment') %></a>
            <a href="/giai-phap/workshop"><%= t('nav.solutionWorkshop') %></a>
            <a href="/giai-phap/dao-tao"><%= t('nav.solutionEducation') %></a>
            <a href="/giai-phap/du-an"><%= t('nav.solutionProjects') %></a>
            <a href="/giai-phap/tap-huan"><%= t('nav.solutionTraining') %></a>
          </div>
        </div>

        <div class="nav-dropdown">
          <a class="nav-dropdown-trigger" href="/dich-vu" aria-haspopup="true" aria-expanded="false"><%= t('nav.services') %> <span class="nav-caret" aria-hidden="true">▾</span></a>
          <div class="nav-dropdown-menu">
            <a href="/dich-vu/tu-van-du-hoc"><%= t('nav.serviceStudyAbroad') %></a>
            <a href="/dich-vu/phan-phoi-san-pham"><%= t('nav.serviceDistribution') %></a>
          </div>
        </div>

        <a href="/tin-tuc"><%= t('nav.news') %></a>
        <a href="/ve-mtg"><%= t('nav.about') %></a>
        <a href="/lien-he"><%= t('nav.contact') %></a>
      </nav>

      <div class="header-actions">
        <div class="lang-switch">
          <a href="<%= switchLangUrl('vi') %>" class="<%= lang === 'vi' ? 'active' : '' %>">VI</a>
          <a href="<%= switchLangUrl('en') %>" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
        </div>
        <% if (!user) { %><%- include('theme-toggle', { label: t('theme.dark'), compact: true }) %><% } %>
        <% if (user) { %>
          <%- include('user-menu') %>
        <% } else { %>
          <a href="/dang-nhap" class="btn btn-ghost btn-sm"><%= t('nav.login') %></a>
          <a href="/dang-ky" class="btn btn-primary btn-sm"><%= t('nav.register') %></a>
        <% } %>
      </div>
    </div>
  </header>
  <main>
