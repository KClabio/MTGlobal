<%# Đối tác đồng hành (Trang chủ and Về MTG): one line of logos sliding slowly to the right and looping (public/js/main.js
    copies the list so it wraps round to the first partner); it stops while the mouse is over the row or the ‹ › buttons.
    Without JavaScript: one line to scroll sideways. Goes inside a section's .container; locals: partners. %>
<div class="section-head domains-head">
  <h2 class="section-title"><%= t('home.partnersTitle') %></h2>
  <% if (partners && partners.length) { %>
    <div class="domain-arrows" data-partner-arrows>
      <button type="button" class="domain-arrow" data-partner-prev aria-label="<%= t('home.partnersPrev') %>" title="<%= t('home.partnersPrev') %>">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button type="button" class="domain-arrow" data-partner-next aria-label="<%= t('home.partnersNext') %>" title="<%= t('home.partnersNext') %>">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  <% } %>
</div>
<% if (partners && partners.length) { %>
  <div class="partner-marquee" data-partner-marquee>
    <div class="partner-strip is-marquee" role="list" aria-label="<%= t('home.partnersTitle') %>">
      <% partners.forEach(function (partner) { %><%- include('partner-tile', { partner, listItem: true }) %><% }) %>
    </div>
  </div>
<% } else { %>
  <p class="empty-note"><%= lang === 'en' ? 'Partner logos coming soon.' : 'Danh sách đối tác đang được cập nhật.' %></p>
<% } %>
