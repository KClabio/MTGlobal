<%#
  A captioned photo or video for solution-page galleries.
  include('partials/media-figure', { src, caption, video: false, poster, ratio: '4/3', contain: false, alt, zoom: false })
  alt: the picture's text when it differs from the shown caption (defaults to the caption)
  zoom: a photo becomes a button that opens it larger in a box on the page (public/js/main.js, the "Xem ảnh lớn" box).
  A button, not a link to the file, so hovering previews nothing; without JS the picture just stays as it is.
%><%
  const mfRatio = typeof ratio !== 'undefined' && ratio ? ratio : '4/3';
  const mfIsVideo = typeof video !== 'undefined' && video;
  const mfCaption = typeof caption !== 'undefined' ? caption : '';
  const mfContain = typeof contain !== 'undefined' && contain;
  const mfAlt = typeof alt !== 'undefined' && alt ? alt : mfCaption;
  const mfZoom = typeof zoom !== 'undefined' && zoom && !mfIsVideo;
%><figure class="media-figure<%= mfContain ? ' is-contain' : '' %><%= mfZoom ? ' is-zoomable' : '' %>">
  <% if (mfZoom) { %>
  <button type="button" class="media-zoom" data-image-view data-full="<%= src %>" data-title="<%= mfCaption %>" data-alt="<%= mfAlt %>"
          aria-label="<%= t('solutionPage.viewFull') %><%= mfCaption ? ': ' + mfCaption : '' %>" data-back-label="<%= t('common.back') %>"
          data-loading="<%= t('solutionPage.imageLoading') %>" data-failed="<%= t('solutionPage.imageFailed') %>" data-open="<%= t('solutionPage.openImage') %>">
  <% } %>
  <div class="media-frame" style="aspect-ratio:<%= mfRatio %>;">
    <% if (mfIsVideo) { %>
      <%# Watch only: play/pause, time bar, volume, fullscreen; no download, speed, picture-in-picture or casting (see public/js/main.js) %>
      <video controls controlsList="nodownload noplaybackrate noremoteplayback" disablePictureInPicture disableRemotePlayback preload="metadata" playsinline<% if (typeof poster !== 'undefined' && poster) { %> poster="<%= poster %>"<% } %>>
        <source src="<%= src %>" type="video/mp4">
      </video>
    <% } else { %>
      <img src="<%= src %>" alt="<%= mfAlt %>" loading="lazy">
    <% } %>
    <% if (mfZoom) { %>
      <span class="media-zoom-badge" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg></span>
    <% } %>
  </div>
  <% if (mfZoom) { %></button><% } %>
  <% if (mfCaption) { %><figcaption><%= mfCaption %></figcaption><% } %>
</figure>
