<%- include('partials/header', { title: t('nav.solutionProjects') + ' - MTG', bannerKey: 'du-an' }) %>

<%- include('partials/page-banner', {
  pill: t('nav.solutions'),
  heading: t('nav.solutionProjects'),
  bannerKey: 'du-an'
}) %>

<section class="section">
  <div class="container">
    <% if (projects && projects.length) { %>
      <%- include('partials/card-search', { placeholder: t('projectsPage.search'), one: t('projectsPage.resultsOne'), many: t('projectsPage.resultsCount'), none: t('projectsPage.noResults') }) %>
      <%# One section per school level (THCS, THPT, Đại học; "Khác" only when used) — see lib/project-levels.js %>
      <%# The first card with a photo is the page's main picture: it loads at once; the others load lazily, so on a
          phone they don't share the slow connection with it (on a wide screen they are on screen and still show at once) %>
      <% let mainPicture = false; %>
      <% groups.forEach(function (g) { %>
        <div class="level-group" id="<%= g.key %>" data-search-group>
          <div class="level-head">
            <h2><%= t('projectLevels.' + g.key) %></h2>
            <span class="level-sub"><%= t('projectsPage.levelSub.' + g.key) %></span>
            <span class="level-count" data-search-group-count><%= g.items.length %></span>
          </div>
          <% if (g.items.length) { %>
            <div class="card-grid">
              <% g.items.forEach(function (project) { %>
                <% const eager = !mainPicture && !!(project.images && project.images[0]); if (eager) mainPicture = true; %>
                <%- include('partials/project-card', { project, eager }) %>
              <% }) %>
            </div>
          <% } else { %>
            <p class="level-empty" data-search-empty><%= t('projectsPage.levelEmpty') %></p>
          <% } %>
        </div>
      <% }) %>
      <p class="empty-note search-none" data-search-none hidden></p>
    <% } else { %>
      <p class="empty-note"><%= lang === 'en' ? 'Reference projects are being updated.' : 'Danh sách dự án đang được cập nhật.' %></p>
    <% } %>
  </div>
</section>

<%- include('partials/next-steps', { current: 'du-an' }) %>

<%- include('partials/footer') %>
