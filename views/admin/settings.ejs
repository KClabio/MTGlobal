<%- include('partials/head', { active: 'thong-tin' }) %>
<% const contact = settings.contactInfo || {}; %>

<div class="admin-topbar">
  <div>
    <h1><%= t('admin.settings.title') %></h1>
    <p class="admin-subtitle"><%= t('admin.settings.subtitle') %></p>
  </div>
</div>

<% if (error) { %><div class="form-alert error"><%= error %></div><% } %>

<form method="POST" action="/admin/thong-tin-cong-ty">
  <div class="admin-form-grid">
    <div>
      <div class="form-group">
        <label for="companyProfile"><%= t('admin.settings.profileVi') %></label>
        <textarea class="form-control" id="companyProfile" name="companyProfile" rows="10"><%= settings.companyProfile || '' %></textarea>
        <%- include('partials/plain-text-hint') %>
      </div>

      <div class="form-group">
        <label for="companyProfileEn"><%= t('admin.settings.profileEn') %></label>
        <textarea class="form-control" id="companyProfileEn" name="companyProfileEn" rows="10"><%= settings.companyProfileEn || '' %></textarea>
        <%- include('partials/plain-text-hint') %>
      </div>

      <%# Chính sách bảo mật: the box shows the admin's own text, else the default draft (lib/privacy-policy.js) %>
      <h3 id="chinh-sach-bao-mat"><%= t('admin.settings.privacyTitle') %></h3>
      <p class="form-hint" data-privacy-draft-note><%= t('admin.settings.privacyDraft') %> <a href="/chinh-sach-bao-mat" target="_blank" rel="noopener"><%= t('admin.viewPage.item', { name: t('privacy.title') }) %> ↗</a></p>
      <% if (!contact.email) { %><p class="form-hint" data-privacy-no-email>⚠ <%= t('admin.settings.privacyNoEmail') %></p><% } %>
      <div class="form-group">
        <label for="privacyPolicy"><%= t('admin.settings.privacyVi') %></label>
        <textarea class="form-control" id="privacyPolicy" name="privacyPolicy" rows="14"><%= settings.privacyPolicy || privacyDefault.vi %></textarea>
        <p class="form-hint"><%= t('admin.settings.privacyHint') %></p>
      </div>
      <div class="form-group">
        <label for="privacyPolicyEn"><%= t('admin.settings.privacyEn') %></label>
        <textarea class="form-control" id="privacyPolicyEn" name="privacyPolicyEn" rows="14"><%= settings.privacyPolicyEn || privacyDefault.en %></textarea>
        <%- include('partials/plain-text-hint') %>
      </div>
    </div>

    <aside>
      <h3><%= t('admin.settings.contactTitle') %></h3>
      <div class="form-group">
        <label for="address"><%= t('admin.settings.address') %></label>
        <input class="form-control" id="address" name="address" value="<%= contact.address || '' %>">
      </div>
      <div class="form-group">
        <label for="phone"><%= t('admin.settings.phone') %></label>
        <input class="form-control" id="phone" name="phone" value="<%= contact.phone || '' %>">
      </div>
      <div class="form-group">
        <label for="email"><%= t('admin.settings.email') %></label>
        <input class="form-control" id="email" name="email" value="<%= contact.email || '' %>">
      </div>
      <div class="form-group">
        <label for="mapEmbedUrl"><%= t('admin.settings.map') %></label>
        <input class="form-control" id="mapEmbedUrl" name="mapEmbedUrl" value="<%= contact.mapEmbedUrl || '' %>">
      </div>
      <p class="form-hint"><%= t('admin.settings.brandMoved') %> <a href="/admin/cai-dat"><%= t('admin.nav.settings') %> →</a></p>
      <button type="submit" class="btn btn-primary btn-block"><%= t('admin.settings.save') %></button>
    </aside>
  </div>
</form>

<%- include('partials/view-page-fab', { href: '/ve-mtg', label: t('admin.viewPage.item', { name: t('nav.about') }) }) %>
<%- include('partials/foot') %>
