<%- include('partials/head', { active: 'cai-dat' }) %>
<%
  const G = (key, vars) => t('admin.general.' + key, vars);
  const hero = settings.homeHero || {};
  const heroImage = settings.heroImages && settings.heroImages.home;
  // Website menu groups, in menu order, for the banner cards
  const GROUPS = [
    { key: 'products', label: t('nav.products') },
    { key: 'solutions', label: t('nav.solutions') },
    { key: 'services', label: t('nav.services') },
    { key: 'news', label: t('nav.news') },
    { key: 'about', label: t('nav.about') },
    { key: 'contact', label: t('nav.contact') },
  ];
  const TABS = [
    { key: 'brand', label: G('tabBrand') },
    { key: 'home', label: G('tabHome') },
    { key: 'banners', label: G('tabBanners'), count: banners.length },
    { key: 'reset', label: G('tabReset') },
  ];
%>

<div class="admin-topbar">
  <div>
    <h1><%= t('admin.nav.settings') %></h1>
    <p class="admin-subtitle"><%= G('subtitle') %></p>
  </div>
</div>

<% if (error) { %><div class="form-alert error"><%= error %></div><% } %>

<form method="POST" action="/admin/cai-dat" enctype="multipart/form-data" data-tabbed-form>
  <input type="hidden" name="tab" value="<%= openTab %>" data-current-tab>
  <div class="admin-tabs" role="tablist" data-tabs data-open="<%= openTab %>">
    <% TABS.forEach(function (tab) { %>
      <button type="button" class="admin-tab" role="tab" data-tab="<%= tab.key %>" id="tab-<%= tab.key %>" aria-controls="panel-<%= tab.key %>">
        <%= tab.label %><% if (tab.count !== undefined) { %> <span class="admin-tab-count"><%= tab.count %></span><% } %>
      </button>
    <% }) %>
  </div>

  <!-- Brand -->
  <section class="admin-tab-panel" role="tabpanel" id="panel-brand" data-panel="brand" aria-labelledby="tab-brand"<%= openTab === 'brand' ? '' : ' hidden' %>>
    <div class="settings-card">
      <h2 class="admin-panel-title"><%= t('admin.settings.logo') %></h2>
      <p class="form-hint"><%= G('logoHint') %></p>
      <% if (settings.logo) { %><div class="logo-preview"><img src="<%= settings.logo %>" alt="MTG"></div><% } %>
      <input class="form-control" type="file" name="logo" accept="image/*" aria-label="<%= t('admin.settings.logo') %>">
    </div>
  </section>

  <!-- Home page hero -->
  <section class="admin-tab-panel" role="tabpanel" id="panel-home" data-panel="home" aria-labelledby="tab-home"<%= openTab === 'home' ? '' : ' hidden' %>>
    <div class="settings-card">
      <h2 class="admin-panel-title"><%= G('heroImage') %></h2>
      <p class="form-hint"><%= G('heroImageHint') %></p>
      <% if (heroImage) { %>
        <div class="banner-preview is-hero"><img src="<%= heroImage %>" alt=""></div>
        <label class="checkbox-row banner-remove"><input type="checkbox" name="removeHeroHome" value="1"> <%= G('removeImage') %></label>
      <% } %>
      <input class="form-control" type="file" name="heroHome" accept="image/*" aria-label="<%= G('heroImage') %>">
    </div>
    <div class="settings-card">
      <h2 class="admin-panel-title"><%= G('heroText') %></h2>
      <p class="form-hint"><%= G('defaultHint') %></p>
      <div class="form-row">
        <div class="form-group"><label for="heroTitleVi"><%= G('heroTitleVi') %></label><input class="form-control" id="heroTitleVi" name="heroTitleVi" value="<%= hero.titleVi || '' %>" placeholder="<%= tVi('home.heroTitle') %>"></div>
        <div class="form-group"><label for="heroTitleEn"><%= G('heroTitleEn') %></label><input class="form-control" id="heroTitleEn" name="heroTitleEn" value="<%= hero.titleEn || '' %>" placeholder="<%= tEn('home.heroTitle') %>"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label for="heroSubtitleVi"><%= G('heroSubtitleVi') %></label><textarea class="form-control" id="heroSubtitleVi" name="heroSubtitleVi" rows="3" placeholder="<%= tVi('home.heroSubtitle') %>"><%= hero.subtitleVi || '' %></textarea></div>
        <div class="form-group"><label for="heroSubtitleEn"><%= G('heroSubtitleEn') %></label><textarea class="form-control" id="heroSubtitleEn" name="heroSubtitleEn" rows="3" placeholder="<%= tEn('home.heroSubtitle') %>"><%= hero.subtitleEn || '' %></textarea></div>
      </div>
      <a class="btn btn-ghost btn-sm" href="/" target="_blank" rel="noopener"><%= G('viewPage') %> ↗</a>
    </div>
  </section>

  <!-- Page banners, grouped like the website menu: one short row per page, one row open at a time -->
  <section class="admin-tab-panel" role="tabpanel" id="panel-banners" data-panel="banners" aria-labelledby="tab-banners"<%= openTab === 'banners' ? '' : ' hidden' %>>
    <p class="admin-hint"><%- include('partials/icon', { name: 'image', size: 16 }) %><span><%= G('bannersHint') %></span></p>
    <div class="banner-list" data-banner-list>
    <% GROUPS.forEach(function (group) { %>
      <% const list = banners.filter(function (b) { return b.group === group.key; }); %>
      <% if (!list.length) return; %>
      <h2 class="admin-panel-title banner-group-title"><%= group.label %></h2>
      <div class="banner-rows">
        <% list.forEach(function (b) { %>
          <% const saved = (settings.banners && settings.banners[b.key]) || {}; %>
          <div class="banner-row" id="banner-<%= b.key %>" data-banner-row
               data-default-vi="<%= b.defaultVi %>" data-default-en="<%= b.defaultEn %>"
               data-saved-image="<%= saved.image ? encodeURI(saved.image) : '' %>">
            <button type="button" class="banner-row-head" data-banner-toggle aria-expanded="false" aria-controls="banner-edit-<%= b.key %>">
              <span class="banner-thumb" data-banner-thumb<% if (saved.image) { %> style="--hero-image: url('<%= encodeURI(saved.image) %>');"<% } %>></span>
              <span class="banner-row-text">
                <span class="banner-row-name"><%= t(b.labelKey) %></span>
                <span class="banner-row-line" data-banner-summary></span>
              </span>
              <span class="banner-row-badges">
                <span class="tag tag-muted" data-badge="default"><%= G('badgeDefault') %></span>
                <span class="tag tag-blue" data-badge="custom" hidden><%= G('badgeCustom') %></span>
                <span class="tag tag-green" data-badge="image" hidden><%= G('badgeImage') %></span>
              </span>
              <span class="banner-row-action"><span data-when="closed"><%- include('partials/icon', { name: 'pencil', size: 15 }) %> <%= G('edit') %></span><span data-when="open"><%= G('close') %></span><%- include('partials/icon', { name: 'chevron-down', size: 16, cls: 'banner-chevron' }) %></span>
            </button>
            <div class="banner-editor" id="banner-edit-<%= b.key %>" hidden>
              <div class="banner-live" data-banner-live aria-hidden="true">
                <strong data-live-title="vi"><%= tVi(b.labelKey) %></strong><strong data-live-title="en" hidden><%= tEn(b.labelKey) %></strong>
                <span data-banner-live-line></span>
              </div>
              <p class="banner-live-note"><%= G('previewNote') %></p>
              <div class="bi-row">
                <div class="form-group">
                  <label for="bannerVi_<%= b.key %>"><%= G('bannerVi') %></label>
                  <textarea class="form-control" id="bannerVi_<%= b.key %>" name="bannerVi_<%= b.key %>" rows="3" data-banner-text="vi" placeholder="<%= b.defaultVi || G('noDefault') %>"><%= saved.subtitleVi || '' %></textarea>
                </div>
                <div class="form-group">
                  <label for="bannerEn_<%= b.key %>"><%= G('bannerEn') %></label>
                  <textarea class="form-control" id="bannerEn_<%= b.key %>" name="bannerEn_<%= b.key %>" rows="3" data-banner-text="en" placeholder="<%= b.defaultEn || G('noDefault') %>"><%= saved.subtitleEn || '' %></textarea>
                </div>
              </div>
              <div class="banner-editor-actions">
                <button type="button" class="btn btn-ghost btn-sm" data-banner-default><%- include('partials/icon', { name: 'rotate-ccw', size: 15 }) %> <%= G('useDefault') %></button>
                <label class="btn btn-ghost btn-sm page-media-pick"><%- include('partials/icon', { name: 'image', size: 16 }) %> <span data-when-image="none"><%= G('pickImage') %></span><span data-when-image="some"><%= G('replaceImage') %></span>
                  <input type="file" class="visually-hidden-file" id="banner_<%= b.key %>" name="banner_<%= b.key %>" accept="image/*" data-banner-file aria-label="<%= G('bannerImage') %>">
                </label>
                <% if (saved.image) { %>
                  <label class="checkbox-row banner-remove"><input type="checkbox" name="removeBanner_<%= b.key %>" value="1" data-banner-remove> <%= G('removeImage') %></label>
                <% } %>
                <span class="banner-file-name" data-banner-file-name></span>
                <a class="btn btn-ghost btn-sm banner-view" href="<%= b.url %>" target="_blank" rel="noopener"><%= G('viewPage') %> ↗</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% }) %>
    </div>
  </section>

  <!-- Back to the default content of the Giải pháp pages. The boxes and the button belong to the "reset-pages" form
       below the main form (forms can't be nested); the main "Lưu cài đặt" bar is hidden on this tab. -->
  <section class="admin-tab-panel" role="tabpanel" id="panel-reset" data-panel="reset" aria-labelledby="tab-reset"<%= openTab === 'reset' ? '' : ' hidden' %>>
    <div class="settings-card reset-card" data-reset-pages data-confirm-one="<%= G('resetConfirmOne') %>" data-confirm-many="<%= G('resetConfirmMany') %>" data-picked="<%= G('resetPicked') %>">
      <h2 class="admin-panel-title"><%= G('resetTitle') %></h2>
      <p class="form-hint"><%= G('resetIntro') %></p>
      <p class="reset-warning"><%- include('partials/icon', { name: 'rotate-ccw', size: 16 }) %><span><%= G('resetWarning') %></span></p>
      <label class="checkbox-row reset-all"><input type="checkbox" data-reset-all> <%= G('resetAll') %></label>
      <ul class="reset-list">
        <% resetPages.forEach(function (p) { %>
          <li class="reset-row">
            <label class="reset-check">
              <input type="checkbox" name="pages" value="<%= p.slug %>" form="reset-pages" data-reset-page data-name="<%= p.name %>">
              <span class="reset-text">
                <span class="reset-name"><%= p.name %></span>
                <span class="reset-date"><%= p.updatedAt ? G('resetSavedOn', { date: new Date(p.updatedAt).toLocaleDateString(lang === 'en' ? 'en-US' : 'vi-VN') }) : G('resetNeverSaved') %></span>
              </span>
            </label>
            <a class="btn btn-ghost btn-sm" href="/giai-phap/<%= p.slug %>" target="_blank" rel="noopener"><%= G('viewPage') %> ↗</a>
          </li>
        <% }) %>
      </ul>
      <div class="reset-actions">
        <span class="reset-picked" data-reset-picked aria-live="polite"></span>
        <button type="submit" form="reset-pages" class="btn btn-danger" data-reset-submit disabled><%- include('partials/icon', { name: 'rotate-ccw', size: 16 }) %> <%= G('resetButton') %></button>
      </div>
    </div>
  </section>

  <div class="form-actions page-form-actions" data-save-bar>
    <button class="btn btn-primary" type="submit"><%= t('admin.settings.save') %></button>
  </div>
</form>

<form id="reset-pages" method="POST" action="/admin/cai-dat/khoi-phuc" data-confirm="" data-confirm-title="<%= G('resetTitle') %>"></form>

<%- include('partials/foot') %>
