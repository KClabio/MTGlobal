<%- include('partials/head', { active: 'doi-tac' }) %>

<div class="admin-topbar"><h1><%= t(partner && partner._id ? 'admin.partners.formEdit' : 'admin.partners.formNew') %></h1></div>

<% if (error) { %><div class="form-alert error"><%= error %></div><% } %>

<form method="POST" action="<%= partner && partner._id ? '/admin/doi-tac/' + partner._id + '/sua' : '/admin/doi-tac/moi' %>" enctype="multipart/form-data" style="max-width:520px;">
  <div class="form-group">
    <label><%= t('admin.partners.name') %></label>
    <input class="form-control" name="name" value="<%= (partner && partner.name) || '' %>" required>
  </div>
  <div class="form-group">
    <label><%= t('admin.partners.website') %></label>
    <input class="form-control" name="url" value="<%= (partner && partner.url) || '' %>">
  </div>
  <div class="form-group">
    <label><%= t('admin.partners.logo') %></label>
    <% if (partner && partner.logo) { %><div class="logo-preview"><img src="<%= partner.logo %>" alt="<%= partner.name %>"></div><% } %>
    <input class="form-control" type="file" name="logo" accept="image/*">
  </div>
  <button type="submit" class="btn btn-primary"><%= t('admin.common.save') %></button>
</form>

<%- include('partials/view-page-fab', { href: '/ve-mtg#doi-tac', label: partner && partner._id ? t('admin.viewPage.item', { name: partner.name }) : t('admin.viewPage.list') }) %>

<%- include('partials/foot') %>
