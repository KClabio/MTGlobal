<%- include('partials/head', { active: 'tin-tuc' }) %>
<% const ROLE_TAG = { owner: 'tag role-owner', admin: 'tag role-admin', customer: 'tag' }; %>

<div class="admin-topbar">
  <h1><%= t('admin.articles.title') %> <span class="count-badge"><%= articles.length %></span></h1>
  <a class="btn btn-primary" href="/admin/tin-tuc/moi"><%= t('admin.articles.add') %></a>
</div>

<%- include('partials/list-search', { target: 'articles' }) %>

<%- include('partials/sort-hint') %>

<div style="overflow-x:auto;">
<table class="data-table">
  <thead><tr><th class="drag-cell"></th><th><%= t('admin.common.image') %></th><th><%= t('admin.articles.colTitle') %></th><th><%= t('admin.articles.colDate') %></th><th><%= t('admin.articles.colUploader') %></th><th><%= t('admin.articles.colVisible') %></th><th></th></tr></thead>
  <tbody data-sortable="articles">
    <% articles.forEach(function (a) { %>
      <tr data-id="<%= a._id %>" data-search="<%= [a.titleVi, a.titleEn, a.uploader && a.uploader.name].filter(Boolean).join(' ') %>">
        <%- include('partials/drag-handle', { name: a.titleVi }) %>
        <td><% if (a.coverImage) { %><img class="thumb" src="<%= resized(a.coverImage, 320) %>" alt="" loading="lazy"><% } %></td>
        <td data-search-name><%= a.titleVi %></td>
        <td><%= new Date(a.createdAt).toLocaleDateString(lang === 'en' ? 'en-US' : 'vi-VN') %></td>
        <td>
          <% if (a.uploader) { %>
            <span class="article-uploader">
              <span class="article-uploader-name"><%= a.uploader.name %></span>
              <% if (a.uploader.role) { %><span class="<%= ROLE_TAG[a.uploader.role] || 'tag' %>"><% if (a.uploader.role === 'owner') { %><%- include('partials/icon', { name: 'crown', size: 13 }) %><% } %> <%= t('admin.roles.' + a.uploader.role) %></span><% } %>
            </span>
          <% } else { %><span class="article-uploader-none">—</span><% } %>
        </td>
        <td><%= a.published ? t('admin.articles.visible') : t('admin.articles.hidden') %></td>
        <td>
          <div class="row-actions">
            <a class="btn btn-ghost btn-sm" href="/admin/tin-tuc/<%= a._id %>/sua"><%= t('admin.common.edit') %></a>
            <form method="POST" action="/admin/tin-tuc/<%= a._id %>/xoa" data-confirm="<%= t('admin.articles.confirmDelete') %>">
              <button class="btn btn-danger btn-sm" type="submit"><%= t('admin.common.delete') %></button>
            </form>
          </div>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<p class="empty-note list-search-none" data-list-search-none="articles" hidden></p>
<% if (!articles.length) { %><p class="empty-note"><%= t('admin.common.empty') %></p><% } %>

<%- include('partials/view-page-fab', { href: '/tin-tuc', label: t('admin.viewPage.list') }) %>

<%- include('partials/foot') %>
