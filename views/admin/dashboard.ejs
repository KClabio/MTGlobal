<%- include('partials/head', { active: 'dashboard' }) %>
<%
  const k = dash.kpis;
  const m = dash.monthly;
  const hasRequests = k.totalRequests > 0;
  const ipie = dash.interestPie;
%>

<div class="admin-topbar">
  <div>
    <h1><%= t('admin.dashboard.title') %></h1>
    <p class="admin-subtitle"><%= t('admin.dashboard.subtitle') %></p>
  </div>
  <a class="btn btn-primary btn-sm" href="/admin/yeu-cau?status=moi"><%- include('partials/icon', { name: 'inbox', size: 16 }) %> <%= t('admin.dashboard.viewNew') %></a>
</div>

<!-- KPI tiles -->
<div class="kpi-grid">
  <a class="kpi" href="/admin/yeu-cau?status=moi">
    <span class="icon-chip chip-orange"><%- include('partials/icon', { name: 'bell', size: 20 }) %></span>
    <span class="kpi-label"><%= t('admin.dashboard.kpiNew') %></span>
    <span class="kpi-value"><%= k.newRequests %></span>
    <span class="kpi-sub"><%= t('admin.dashboard.kpiNewSub', { n: k.requestsLast7 }) %></span>
  </a>
  <a class="kpi" href="/admin/yeu-cau">
    <span class="icon-chip chip-blue"><%- include('partials/icon', { name: 'inbox', size: 20 }) %></span>
    <span class="kpi-label"><%= t('admin.dashboard.kpiTotal') %></span>
    <span class="kpi-value"><%= k.totalRequests %></span>
    <span class="kpi-sub"><%= t('admin.dashboard.kpiTotalSub') %> <strong><%= k.completionRate %>%</strong></span>
  </a>
  <a class="kpi" href="/admin/nguoi-dung">
    <span class="icon-chip chip-green"><%- include('partials/icon', { name: 'users', size: 20 }) %></span>
    <span class="kpi-label"><%= t('admin.dashboard.kpiCustomers') %></span>
    <span class="kpi-value"><%= k.customers %></span>
    <span class="kpi-sub"><%= t('admin.dashboard.kpiCustomersSub', { n: k.newCustomers30 }) %></span>
  </a>
  <a class="kpi" href="/admin/tin-tuc">
    <span class="icon-chip chip-violet"><%- include('partials/icon', { name: 'newspaper', size: 20 }) %></span>
    <span class="kpi-label"><%= t('admin.dashboard.kpiNews') %></span>
    <span class="kpi-value"><%= k.articlesPublished %></span>
    <span class="kpi-sub"><%= t('admin.dashboard.kpiNewsSub', { published: k.articlesPublished, total: k.articlesTotal }) %></span>
  </a>
</div>

<div class="dash-grid">
  <!-- Requests per month: columns split by status (as the pie) + line joining the totals (growth), one shared scale -->
  <section class="panel">
    <header class="panel-head">
      <span class="icon-chip chip-blue"><%- include('partials/icon', { name: 'bar-chart', size: 18 }) %></span>
      <div>
        <h2><%= t('admin.dashboard.monthlyTitle') %></h2>
        <p><%= t('admin.dashboard.monthlySub', { n: dash.monthTotal }) %></p>
      </div>
    </header>
    <% if (dash.monthTotal === 0) { %>
      <p class="panel-empty"><%= t('admin.dashboard.monthlyEmpty') %></p>
    <% } %>
    <svg class="chart chart-anim" viewBox="0 0 <%= m.W %> <%= m.H %>" role="img" aria-label="<%= t('admin.dashboard.monthlyAria') %>" style="--n:<%= m.bars.length %>;">
      <defs>
        <%# Soft halo behind a hovered column: a blurred copy of the bar in its own colour %>
        <filter id="chartGlow" x="-60%" y="-30%" width="220%" height="160%"><feGaussianBlur stdDeviation="5"></feGaussianBlur></filter>
      </defs>
      <% m.ticks.forEach(function (tk) { %>
        <line class="chart-grid<%= tk.value === 0 ? ' chart-baseline' : '' %>" x1="<%= m.left %>" x2="<%= m.W - m.right %>" y1="<%= tk.y %>" y2="<%= tk.y %>"></line>
        <text class="chart-tick" x="<%= m.left - 8 %>" y="<%= tk.y + 4 %>" text-anchor="end"><%= tk.value %></text>
      <% }) %>
      <% m.bars.forEach(function (b, i) { %>
        <g class="chart-col" tabindex="0" data-i="<%= i %>" data-tip="<%= b.tip %>" aria-label="<%= b.tip %>" style="--i:<%= i %>;">
          <rect class="chart-hit" x="<%= b.slotX %>" y="<%= m.top %>" width="<%= b.slotW %>" height="<%= m.baseline - m.top %>"></rect>
          <% if (b.d) { %>
            <path class="chart-bar-glow" d="<%= b.d %>" filter="url(#chartGlow)"></path>
            <%# One section per status (bottom → top: Hoàn tất, Đã liên hệ, Mới); the group grows from the baseline %>
            <g class="chart-bar">
              <% b.segments.forEach(function (sg) { %><path class="chart-seg" data-key="<%= sg.key %>" data-n="<%= sg.n %>" d="<%= sg.d %>" style="fill:<%= sg.color %>;"></path><% }) %>
            </g>
          <% } %>
          <text class="chart-label" x="<%= b.cx %>" y="<%= m.H - 10 %>" text-anchor="middle"><%= b.label %></text>
        </g>
      <% }) %>
      <path class="chart-line" d="<%= m.linePath %>" pathLength="1"></path>
      <% m.bars.forEach(function (b, i) { %>
        <g class="chart-pt" data-i="<%= i %>" style="--i:<%= i %>; --at:<%= b.at %>;">
          <circle class="chart-dot-glow" cx="<%= b.cx %>" cy="<%= b.lineY %>" r="7" filter="url(#chartGlow)"></circle>
          <circle class="chart-dot" cx="<%= b.cx %>" cy="<%= b.lineY %>" r="4"></circle>
        </g>
      <% }) %>
    </svg>
    <%# Key: the status sections (colour + the pie's icons, never colour alone), then the total line %>
    <ul class="chart-legend">
      <% m.legend.forEach(function (s) { %>
        <li data-key="<%= s.key %>"><span class="key-swatch" style="background:<%= s.color %>;" aria-hidden="true"></span><span class="key-icon" style="color:<%= s.color %>;" aria-hidden="true"><%- include('partials/icon', { name: s.icon, size: 14 }) %></span><%= s.label %></li>
      <% }) %>
      <li data-key="total"><span class="key-line" aria-hidden="true"></span><%= t('admin.dashboard.seriesTotal') %></li>
    </ul>
    <%# The numbers for screen readers. Hidden by a wrapper: a table ignores the 1px width of .sr-only and widened phone pages %>
    <div class="sr-only"><table>
      <caption><%= t('admin.dashboard.monthlyTitle') %></caption>
      <tr><th><%= t('admin.dashboard.monthCol') %></th><th><%= t('admin.dashboard.totalCol') %></th><% m.legend.forEach(function (s) { %><th><%= s.label %></th><% }) %></tr>
      <% m.bars.forEach(function (b) { %><tr><td><%= b.title %></td><td><%= b.value %></td><% m.legend.forEach(function (s) { %><td><%= b.parts[s.key] %></td><% }) %></tr><% }) %>
    </table></div>
  </section>

  <!-- Interests: pie of the 4 groups (sweeps in on open, a slice slides out on hover); a click on a group opens its own
       pie (Giải pháp STEM → its 5 choices, Sản phẩm → the robots named, Dịch vụ → its 2), with a way back -->
  <%# Two tabs (public/js/admin.js initTabs): the interest pie, and the STEM equipment catalogue by part %>
  <section class="panel" data-pie-panel>
    <header class="panel-head">
      <span class="icon-chip chip-violet"><%- include('partials/icon', { name: 'pie-chart', size: 18 }) %></span>
      <div><h2><%= t('admin.dashboard.pieHeading') %></h2></div>
    </header>
    <div class="admin-tabs pie-tabs" role="tablist" aria-label="<%= t('admin.dashboard.pieHeading') %>" data-tabs data-open="interest">
      <button type="button" class="admin-tab" role="tab" data-tab="interest" id="pie-tab-interest" aria-controls="pie-panel-interest"><%= t('admin.dashboard.pieTabInterest') %></button>
      <button type="button" class="admin-tab" role="tab" data-tab="equipment" id="pie-tab-equipment" aria-controls="pie-panel-equipment"><%= t('admin.nav.equipment') %></button>
    </div>

    <div class="pie-tab-panel" role="tabpanel" id="pie-panel-interest" aria-labelledby="pie-tab-interest" data-panel="interest" data-interest-panel>
    <p class="pie-panel-sub"><%= hasRequests ? t('admin.dashboard.pieSub', { n: k.totalRequests }) : t('admin.dashboard.pieNone') %></p>
    <div class="pie-wrap" data-pie data-pie-view="top">
      <%- include('partials/interest-pie', { view: 'top', data: ipie.top, aria: t('admin.dashboard.pieAria') }) %>
    </div>
    <% Object.keys(ipie.children).forEach(function (key) { const g = ipie.children[key]; %>
      <div class="pie-wrap" data-pie data-pie-view="<%= key %>" hidden>
        <div class="pie-crumb">
          <button type="button" class="btn btn-ghost btn-sm pie-back" data-pie-back>&larr; <%= t('admin.dashboard.interestBack') %></button>
          <span class="pie-crumb-title"><%= t('admin.dashboard.interestCrumb', { group: g.label, n: g.total }) %></span>
        </div>
        <%- include('partials/interest-pie', { view: key, data: g, aria: t('admin.dashboard.interestCrumb', { group: g.label, n: g.total }) }) %>
      </div>
    <% }) %>
    </div>

    <div class="pie-tab-panel" role="tabpanel" id="pie-panel-equipment" aria-labelledby="pie-tab-equipment" data-panel="equipment" hidden>
      <p class="pie-panel-sub">
        <%= dash.equipmentPie.total ? t('admin.dashboard.equipmentSub', { n: dash.equipmentPie.total }) : t('admin.dashboard.equipmentNone') %>
        <a class="pie-more" href="/admin/thiet-bi"><%= t('admin.dashboard.equipmentMore') %> &rarr;</a>
      </p>
      <div class="pie-wrap" data-pie data-pie-view="equipment">
        <%- include('partials/interest-pie', { view: 'equipment', data: dash.equipmentPie, aria: t('admin.dashboard.equipmentAria') }) %>
      </div>
    </div>
  </section>

  <!-- Requests by category: horizontal bars -->
  <section class="panel">
    <header class="panel-head">
      <span class="icon-chip chip-orange"><%- include('partials/icon', { name: 'tag', size: 18 }) %></span>
      <div>
        <h2><%= t('admin.dashboard.interestTitle') %></h2>
        <p><%= t('admin.dashboard.interestSub') %></p>
      </div>
    </header>
    <ul class="hbar-list">
      <% dash.interests.forEach(function (r) { %>
        <li class="hbar-row" tabindex="0" data-tip="<%= t('admin.dashboard.tipInterest', { label: r.label, n: r.count, pct: r.percent }) %>">
          <span class="hbar-label"><%= r.label %></span>
          <span class="hbar-track"><span class="hbar-fill" style="width:<%= r.width %>%;"></span></span>
          <span class="hbar-value"><%= r.count %></span>
        </li>
      <% }) %>
    </ul>
  </section>

  <!-- Latest requests -->
  <section class="panel">
    <header class="panel-head">
      <span class="icon-chip chip-blue"><%- include('partials/icon', { name: 'inbox', size: 18 }) %></span>
      <div>
        <h2><%= t('admin.dashboard.latestTitle') %></h2>
        <p><a href="/admin/yeu-cau"><%= t('admin.dashboard.viewAll') %></a></p>
      </div>
    </header>
    <% if (dash.latest.length) { %>
      <ul class="latest-list">
        <% dash.latest.forEach(function (r) { %>
          <li>
            <div class="latest-main">
              <strong><%= r.name %></strong>
              <span><%= r.interest %></span>
            </div>
            <div class="latest-meta">
              <span class="tag status-<%= r.status %>"><%= r.statusLabel %></span>
              <span class="latest-when"><%= r.when %></span>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="panel-empty"><%= t('admin.dashboard.latestEmpty') %></p>
    <% } %>
  </section>
</div>

<!-- Website content inventory -->
<section class="panel">
  <header class="panel-head">
    <span class="icon-chip chip-violet"><%- include('partials/icon', { name: 'layers', size: 18 }) %></span>
    <div>
      <h2><%= t('admin.dashboard.contentTitle') %></h2>
      <p><%= t('admin.dashboard.contentSub') %></p>
    </div>
  </header>
  <div class="mini-grid">
    <% dash.content.forEach(function (c) { %>
      <a class="mini-tile" href="<%= c.href %>">
        <span class="mini-icon"><%- include('partials/icon', { name: c.icon, size: 20 }) %></span>
        <span class="mini-count"><%= c.count %></span>
        <span class="mini-label"><%= c.label %></span>
      </a>
    <% }) %>
  </div>
</section>

<div class="chart-tooltip" id="chartTooltip" role="status" hidden></div>

<%- include('partials/foot') %>
