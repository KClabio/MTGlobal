<%- include('partials/head', { active: 'yeu-cau' }) %>
<% const interestChips = typeof interests !== 'undefined' ? interests : []; %>

<div class="admin-topbar">
  <div>
    <h1><%= t('admin.requests.title') %></h1>
    <p class="admin-subtitle" data-retention-note><%= t('privacy.retentionNote') %></p>
  </div>
  <div class="row-actions">
    <a class="btn btn-sm <%= statusFilter === '' ? 'btn-primary' : 'btn-ghost' %>" href="/admin/yeu-cau" data-keep-query><%= t('admin.requests.all') %></a>
    <% statuses.forEach(function (s) { %>
      <a class="btn btn-sm <%= statusFilter === s ? 'btn-primary' : 'btn-ghost' %>" href="/admin/yeu-cau?status=<%= s %>" data-keep-query><%= t('admin.status.' + s) %></a>
    <% }) %>
  </div>
</div>

<% if (requests.length) { %>
  <%- include('partials/list-search', { target: 'requests' }) %>
  <% if (interestChips.length) { %>
    <%- include('partials/list-filter', { target: 'requests', param: 'quan-tam', label: t('admin.search.filterInterest'), total: requests.length,
          options: interestChips.map(function (o) { return { value: o.value, label: t('admin.interest.' + o.value), count: o.count }; }) }) %>
  <% } %>
<% } %>

<div style="overflow-x:auto;">
<table class="data-table">
  <thead><tr><th><%= t('admin.requests.colDate') %></th><th><%= t('admin.requests.colName') %></th><th><%= t('admin.requests.colContact') %></th><th><%= t('admin.requests.colInterest') %></th><th><%= t('admin.requests.colMessage') %></th><th><%= t('admin.requests.colStatus') %></th><th></th></tr></thead>
  <tbody data-list="requests">
    <% requests.forEach(function (r) { %>
      <tr data-id="<%= r._id %>" data-search="<%= [r.name, r.schoolOrCompany, r.phone, (r.phone || '').replace(/\D/g, ''), r.email, r.message].concat((r.details || []).map(function (d) { return [d.valueVi, d.valueEn].join(' '); })).filter(Boolean).join(' ') %>" data-filter="<%= r.interestedIn %>">
        <td>
          <%= new Date(r.createdAt).toLocaleDateString(lang === 'en' ? 'en-US' : 'vi-VN') %>
          <%# Changed by the sender after sending ("Yêu cầu của tôi" → Sửa, routes/account.js) %>
          <% if (r.editedAt) { const ed = new Date(r.editedAt); const loc = lang === 'en' ? 'en-US' : 'vi-VN'; %>
            <br><span class="tag tag-edited" data-edited-at title="<%= ed.toLocaleString(loc) %>"><%= t('admin.requests.editedAt', { time: ed.toLocaleTimeString(loc, { hour: '2-digit', minute: '2-digit' }), date: lang === 'en' ? (ed.getMonth() + 1) + '/' + ed.getDate() : String(ed.getDate()).padStart(2, '0') + '/' + String(ed.getMonth() + 1).padStart(2, '0') }) %></span>
          <% } %>
        </td>
        <td><span data-search-name><%= r.name %></span><% if (r.schoolOrCompany) { %><br><small><%= r.schoolOrCompany %></small><% } %></td>
        <td><%= r.phone %> <%= r.email ? '· ' + r.email : '' %></td>
        <% const product = (r.details || []).filter(isProductLine); const answers = (r.details || []).filter(function (d) { return !isProductLine(d); }); %>
        <td data-col="interest">
          <span class="tag"><%= t('admin.interest.' + r.interestedIn) %></span>
          <%# Which robot (robot-page requests) goes with the category; the service's own answers stay with the message %>
          <% if (product.length) { %>
            <dl class="request-details request-product">
              <% product.forEach(function (d) { %><div><dt><%= (lang === 'en' && d.labelEn) || d.labelVi %></dt><dd><%= (lang === 'en' && d.valueEn) || d.valueVi %></dd></div><% }) %>
            </dl>
          <% } %>
        </td>
        <td style="max-width:320px;" data-col="message">
          <%= r.message %>
          <% if (answers.length) { %>
            <dl class="request-details">
              <% answers.forEach(function (d) { %>
                <div><dt><%= (lang === 'en' && d.labelEn) || d.labelVi %></dt><dd><%= (lang === 'en' && d.valueEn) || d.valueVi %></dd></div>
              <% }) %>
            </dl>
          <% } %>
        </td>
        <td>
          <form method="POST" action="/admin/yeu-cau/<%= r._id %>/trang-thai">
            <select class="form-control" name="status" data-autosubmit aria-label="<%= t('admin.requests.colStatus') %>">
              <% statuses.forEach(function (s) { %>
                <option value="<%= s %>" <%= r.status === s ? 'selected' : '' %>><%= t('admin.status.' + s) %></option>
              <% }) %>
            </select>
          </form>
        </td>
        <td>
          <form method="POST" action="/admin/yeu-cau/<%= r._id %>/xoa" data-confirm="<%= t('admin.requests.confirmDelete', { name: r.name }) %>">
            <button class="btn btn-danger btn-sm" type="submit"><%= t('admin.common.delete') %></button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<p class="empty-note list-search-none" data-list-search-none="requests" hidden></p>
<% if (!requests.length) { %><p class="empty-note"><%= t('admin.requests.empty') %></p><% } %>

<%- include('partials/foot') %>
