<%
  const activeNav = typeof active !== 'undefined' ? active : '';
  // Same structure and order as the website menu (views/partials/header.ejs)
  const navGroups = [
    { items: [
      { key: 'dashboard', href: '/admin', label: t('admin.nav.dashboard'), icon: 'layout-dashboard' },
    ] },
    { label: t('admin.navGroups.products'), items: [
      { key: 'robot', href: '/admin/robot', label: t('admin.nav.robots'), icon: 'bot' },
    ] },
    { label: t('admin.navGroups.solutions'), items: [
      { key: 'trang-stem-lab', href: '/admin/trang/stem-lab', label: t('admin.nav.pageStemLab'), icon: 'layout-template' },
      { key: 'thiet-bi', href: '/admin/thiet-bi', label: t('admin.nav.equipment'), icon: 'cpu' },
      { key: 'trang-workshop', href: '/admin/trang/workshop', label: t('admin.nav.pageWorkshop'), icon: 'wrench' },
      { key: 'trang-dao-tao', href: '/admin/trang/dao-tao', label: t('admin.nav.pageEducation'), icon: 'graduation-cap' },
      { key: 'du-an', href: '/admin/du-an', label: t('admin.nav.projects'), icon: 'folder-kanban' },
      { key: 'trang-tap-huan', href: '/admin/trang/tap-huan', label: t('admin.nav.pageTraining'), icon: 'presentation' },
    ] },
    { label: t('admin.navGroups.services'), items: [
      { key: 'dich-vu', href: '/admin/dich-vu', label: t('admin.nav.services'), icon: 'briefcase' },
    ] },
    { label: t('admin.navGroups.news'), items: [
      { key: 'tin-tuc', href: '/admin/tin-tuc', label: t('admin.nav.news'), icon: 'newspaper' },
    ] },
    { label: t('admin.navGroups.about'), items: [
      { key: 'thong-tin', href: '/admin/thong-tin-cong-ty', label: t('admin.nav.companyInfo'), icon: 'building' },
      { key: 'doi-tac', href: '/admin/doi-tac', label: t('admin.nav.partners'), icon: 'handshake' },
    ] },
    { label: t('admin.navGroups.manage'), items: [
      { key: 'yeu-cau', href: '/admin/yeu-cau', label: t('admin.nav.requests'), icon: 'inbox' },
      { key: 'nguoi-dung', href: '/admin/nguoi-dung', label: t('admin.nav.users'), icon: 'users' },
      { key: 'cai-dat', href: '/admin/cai-dat', label: t('admin.nav.settings'), icon: 'settings' },
    ] },
  ];
%>
<!doctype html>
<html lang="<%= lang %>" data-theme="<%= theme %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin.pageTitle') %></title>
  <%# The website's styles (some admin forms reuse them), then the admin's own, as one file (lib/assets.js) %>
  <link rel="stylesheet" href="<%= asset('/css/admin-all.css') %>">
  <script nonce="<%= cspNonce %>">document.documentElement.classList.add('js');</script>
</head>
<body>
  <div class="admin-wrap">
    <%# On wide screens a fixed menu on the left; at 960px and below it is hidden and slides in from the left with the
        round ☰ button above the page title (public/js/admin.js), × / the dark backdrop / Esc close it %>
    <aside class="admin-sidebar" id="adminSidebar" aria-label="<%= t('admin.menuLabel') %>">
      <div class="admin-brand-row">
        <a href="/admin" class="admin-brand">
          <img src="/images/mtg-logo-transparent.png" alt="MTG - Smart solutions for Life">
          <span><%= t('admin.brand') %></span>
        </a>
        <button type="button" class="admin-menu-close" aria-label="<%= t('admin.menuClose') %>" title="<%= t('admin.menuClose') %>"><%- include('icon', { name: 'x', size: 18 }) %></button>
      </div>
      <nav class="admin-nav">
        <% navGroups.forEach(function (group) { %>
          <% if (group.label) { %><span class="admin-nav-group"><%= group.label %></span><% } %>
          <% group.items.forEach(function (item) { %>
            <a href="<%= item.href %>" class="<%= activeNav === item.key ? 'active' : '' %>"<%- activeNav === item.key ? ' aria-current="page"' : '' %>>
              <%- include('icon', { name: item.icon }) %><span><%= item.label %></span>
            </a>
          <% }) %>
        <% }) %>
        <a href="/" class="admin-nav-home"><%- include('icon', { name: 'arrow-left' }) %><span><%= t('admin.nav.backHome') %></span></a>
      </nav>
      <div class="admin-lang" role="group" aria-label="<%= t('admin.language') %>">
        <%- include('icon', { name: 'globe', size: 16 }) %>
        <a href="<%= adminLangUrl('vi') %>" class="<%= lang === 'vi' ? 'active' : '' %>" hreflang="vi"<%- lang === 'vi' ? ' aria-current="true"' : '' %>>VI</a>
        <a href="<%= adminLangUrl('en') %>" class="<%= lang === 'en' ? 'active' : '' %>" hreflang="en"<%- lang === 'en' ? ' aria-current="true"' : '' %>>EN</a>
        <%- include('../../partials/theme-toggle', { label: t('admin.theme.dark'), compact: true }) %>
      </div>
    </aside>
    <div class="admin-scrim" hidden></div>
    <script nonce="<%= cspNonce %>">
      // The menu scrolls on its own (a tall list, also when it slides in on narrow screens). Every item loads a new
      // page, so keep the menu where it was (saved per tab) and make sure the current item is in view.
      // Runs right here, before the page is drawn, so the menu never visibly jumps.
      (function () {
        var bar = document.querySelector('.admin-sidebar');
        if (!bar) return;
        var KEY = 'adminNavScroll';
        var saved = null;
        try { saved = JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch (e) { /* storage blocked */ }
        if (saved) bar.scrollTop = saved.top || 0;
        var active = bar.querySelector('.admin-nav a.active');
        if (active) {
          var b = bar.getBoundingClientRect();
          var a = active.getBoundingClientRect();
          // Hidden behind the sticky language bar at the bottom counts as hidden too
          var lang = bar.querySelector('.admin-lang');
          var bottom = b.bottom - (lang && getComputedStyle(lang).position === 'sticky' ? lang.offsetHeight : 0);
          if (a.top < b.top || a.bottom > bottom) bar.scrollTop += a.top - b.top - (bottom - b.top - a.height) / 2;
        }
        function save() {
          try { sessionStorage.setItem(KEY, JSON.stringify({ top: bar.scrollTop })); } catch (e) { /* storage blocked */ }
        }
        bar.addEventListener('click', function (e) { if (e.target.closest('a, button')) save(); });
        window.addEventListener('pagehide', save);
      })();
    </script>
    <main class="admin-main">
      <button type="button" class="admin-menu-btn" aria-controls="adminSidebar" aria-expanded="false" aria-label="<%= t('admin.menuOpen') %>" title="<%= t('admin.menuOpen') %>"><%- include('icon', { name: 'menu', size: 20 }) %></button>
