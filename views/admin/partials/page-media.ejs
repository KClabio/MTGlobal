<%
  // One photo or video already on a solution page: preview, captions, "show whole image", remove, drag to reorder.
  const P = (key) => t('admin.pages.' + key);
%>
<div class="page-media" data-media>
  <input type="hidden" data-media-field="src" value="<%= m.src %>">
  <input type="hidden" data-media-field="type" value="<%= m.type %>">
  <input type="hidden" data-media-field="poster" value="<%= m.poster || '' %>">
  <div class="page-media-thumb">
    <button type="button" class="drag-handle media-drag" aria-label="<%= P('dragMedia') %>" title="<%= P('dragMedia') %>"><%- include('icon', { name: 'grip', size: 16 }) %></button>
    <% if (m.type === 'video') { %>
      <% if (m.poster) { %><img src="<%= m.poster %>" alt="" loading="lazy"><% } else { %><span class="page-media-video"><%- include('icon', { name: 'video', size: 28 }) %></span><% } %>
      <span class="page-media-badge"><%- include('icon', { name: 'video', size: 12 }) %> <%= P('videoLabel') %></span>
    <% } else { %>
      <img src="<%= m.src %>" alt="" loading="lazy">
    <% } %>
  </div>
  <div class="page-media-fields">
    <input class="form-control" data-media-field="captionVi" value="<%= m.captionVi || '' %>" placeholder="<%= P('captionVi') %>" aria-label="<%= P('captionVi') %>">
    <input class="form-control" data-media-field="captionEn" value="<%= m.captionEn || '' %>" placeholder="<%= P('captionEn') %>" aria-label="<%= P('captionEn') %>">
    <div class="page-media-actions">
      <span class="checkbox-row" data-mirror-wrap>
        <label class="checkbox-row" style="margin:0;"><input type="checkbox" data-mirror <%= m.contain ? 'checked' : '' %>> <%= P('contain') %></label>
        <input type="hidden" data-media-field="contain" value="<%= m.contain ? '1' : '0' %>">
      </span>
      <button type="button" class="btn btn-danger-ghost btn-sm" data-remove-media><%= P('removeMedia') %></button>
    </div>
  </div>
</div>
