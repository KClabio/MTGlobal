<%
  // One photo or video already on a solution page, as a row: preview with its number (dragged to reorder), the captions
  // side by side (Vietnamese | English), remove. "Show the whole image" (contain) is a developer setting: it is kept
  // as it is, in a hidden field.
  const P = (key) => t('admin.pages.' + key);
  const pill = (L) => '<span class="lang-pill">' + L.toUpperCase() + '</span>';
%>
<div class="page-media" data-media>
  <input type="hidden" data-media-field="src" value="<%= m.src %>">
  <input type="hidden" data-media-field="type" value="<%= m.type %>">
  <input type="hidden" data-media-field="poster" value="<%= m.poster || '' %>">
  <input type="hidden" data-media-field="contain" value="<%= m.contain ? '1' : '0' %>">
  <div class="page-media-thumb" tabindex="0" aria-label="<%= P('dragMedia') %>">
    <span class="page-media-num" data-media-num aria-hidden="true"></span>
    <% if (m.type === 'video') { %>
      <% if (m.poster) { %><img src="<%= m.poster %>" alt="" loading="lazy" draggable="false"><% } else { %><span class="page-media-video"><%- include('icon', { name: 'video', size: 28 }) %></span><% } %>
      <span class="page-media-badge"><%- include('icon', { name: 'video', size: 12 }) %> <%= P('videoLabel') %></span>
    <% } else { %>
      <img src="<%= m.src %>" alt="" loading="lazy" draggable="false">
    <% } %>
  </div>
  <div class="bi-row page-media-fields">
    <% ['vi', 'en'].forEach(function (l) { const L = l === 'en' ? 'En' : 'Vi'; %>
      <div class="form-group">
        <label><%= P('caption') %> <%- pill(l) %></label>
        <textarea class="form-control page-media-caption" data-media-field="caption<%= L %>" rows="2" data-one-line aria-label="<%= P('caption' + L) %>"><%= m['caption' + L] || '' %></textarea>
      </div>
    <% }) %>
  </div>
  <button type="button" class="icon-btn icon-btn-danger media-remove" data-remove-media aria-label="<%= P('removeMedia') %>" title="<%= P('removeMedia') %>"><%- include('icon', { name: 'trash', size: 16 }) %></button>
</div>
