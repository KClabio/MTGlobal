<%# The order cell of an admin list row: the drag handle (mouse, touch, or ↑ / ↓ keys when focused) and two buttons that
    move the row by a tap or click alone, for touch screens and anyone who can't drag (WCAG 2.2, 2.5.7). public/js/admin.js
    saves the new order the same way for all three. %>
<td class="drag-cell"><div class="drag-tools">
  <button type="button" class="drag-handle" aria-label="<%= t('admin.common.dragHandle', { name: name }) %>" title="<%= t('admin.common.dragHandle', { name: name }) %>"><%- include('icon', { name: 'grip', size: 18 }) %></button>
  <span class="move-btns">
    <button type="button" class="move-btn" data-move-row="up" aria-label="<%= t('admin.common.moveUp', { name: name }) %>" title="<%= t('admin.common.moveUp', { name: name }) %>"><%- include('icon', { name: 'arrow-up', size: 14 }) %></button>
    <button type="button" class="move-btn" data-move-row="down" aria-label="<%= t('admin.common.moveDown', { name: name }) %>" title="<%= t('admin.common.moveDown', { name: name }) %>"><%- include('icon', { name: 'arrow-down', size: 14 }) %></button>
  </span>
</div></td>
