<%- include('partials/head', { active: 'tin-tuc' }) %>

<div class="admin-topbar"><h1><%= t(article && article._id ? 'admin.articles.formEdit' : 'admin.articles.formNew') %></h1></div>

<% if (error) { %><div class="form-alert error"><%= error %></div><% } %>

<form method="POST" action="<%= article && article._id ? '/admin/tin-tuc/' + article._id + '/sua' : '/admin/tin-tuc/moi' %>" enctype="multipart/form-data">
  <div class="admin-form-grid">
    <div>
      <div class="form-group">
        <label><%= t('admin.articles.titleVi') %></label>
        <input class="form-control" name="titleVi" value="<%= (article && article.titleVi) || '' %>" required>
      </div>
      <div class="form-group">
        <label><%= t('admin.articles.titleEn') %></label>
        <input class="form-control" name="titleEn" value="<%= (article && article.titleEn) || '' %>">
      </div>
      <div class="form-group">
        <label><%= t('admin.articles.bodyVi') %></label>
        <textarea class="form-control" name="bodyVi" rows="10"><%= (article && article.bodyVi) || '' %></textarea>
        <%- include('partials/plain-text-hint') %>
      </div>
      <div class="form-group">
        <label><%= t('admin.articles.bodyEn') %></label>
        <textarea class="form-control" name="bodyEn" rows="10"><%= (article && article.bodyEn) || '' %></textarea>
        <%- include('partials/plain-text-hint') %>
      </div>
      <div class="form-group">
        <label><%= t('admin.articles.cover') %></label>
        <% if (article && article.coverImage) { %><div class="media-thumb" style="margin-bottom:10px;"><img src="<%= article.coverImage %>" alt=""></div><% } %>
        <input class="form-control" type="file" name="coverImage" accept="image/*">
      </div>
    </div>
    <aside>
      <div class="checkbox-row form-group">
        <input type="checkbox" id="published" name="published" <%= !article || article.published ? 'checked' : '' %>>
        <label for="published" style="margin:0;"><%= t('admin.articles.published') %></label>
      </div>
      <%# Người đăng: owners pick any owner/admin account; admins only see it %>
      <div class="form-group">
        <% const roleText = (r) => t('admin.roles.' + r); %>
        <% if (staff) { %>
          <label for="uploadedBy"><%= t('admin.articles.uploader') %></label>
          <select class="form-control" id="uploadedBy" name="uploadedBy">
            <% if (!uploader) { %><option value=""<%= picked === '' ? ' selected' : '' %>><%= t('admin.articles.uploaderNone') %></option><% } %>
            <% if (uploader && !uploader.staff) { %>
              <option value="keep"<%= picked === 'keep' ? ' selected' : '' %>><%= uploader.name %> (<%= t(uploader.gone ? 'admin.articles.uploaderGone' : 'admin.articles.uploaderNotStaff') %>)</option>
            <% } %>
            <% staff.forEach(function (u) { %>
              <option value="<%= u._id %>"<%= picked === String(u._id) ? ' selected' : '' %>><%= u.name %> · <%= roleText(u.role) %></option>
            <% }) %>
          </select>
          <p class="form-hint"><%= t('admin.articles.uploaderHint') %></p>
        <% } else { %>
          <label><%= t('admin.articles.uploader') %></label>
          <div data-uploader>
            <% if (uploader) { %>
              <span class="article-uploader">
                <span class="article-uploader-name"><%= uploader.name %></span>
                <% if (uploader.role) { %><span class="tag<%= uploader.role === 'owner' ? ' role-owner' : uploader.role === 'admin' ? ' role-admin' : '' %>"><% if (uploader.role === 'owner') { %><%- include('partials/icon', { name: 'crown', size: 13 }) %> <% } %><%= roleText(uploader.role) %></span><% } %>
              </span>
            <% } else { %><span class="article-uploader-none">—</span><% } %>
          </div>
        <% } %>
      </div>
      <button type="submit" class="btn btn-primary btn-block"><%= t('admin.common.save') %></button>
    </aside>
  </div>
</form>

<% const articleLive = article && article._id && (article.published === true || article.published === 'on'); %>
<%- include('partials/view-page-fab', !(article && article._id)
  ? { href: '/tin-tuc', label: t('admin.viewPage.list') }
  : articleLive
    ? { href: '/tin-tuc/' + article._id, label: t('admin.viewPage.item', { name: article.titleVi }) }
    : { disabledReason: t('admin.viewPage.hiddenArticle') }) %>

<%- include('partials/foot') %>
