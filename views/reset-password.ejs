<%- include('partials/header', { title: t('reset.newTitle') + ' - MTG', noindex: true }) %>

<section class="section">
  <div class="container" style="max-width:480px;">
    <h1 style="text-align:center;"><%= t('reset.newTitle') %></h1>
    <div class="form-card">
      <% if (!token) { %>
        <div class="form-alert error" data-reset-bad><%= t('reset.badLink') %></div>
        <p class="auth-switch"><a href="/quen-mat-khau"><%= t('reset.askAgain') %></a></p>
      <% } else { %>
        <% if (error) { %><div class="form-alert error"><%= error %></div><% } %>
        <form method="POST" action="/dat-lai-mat-khau/<%= token %>">
          <div class="form-group">
            <label for="resetPassword"><%= t('profile.newPassword') %></label>
            <%- include('partials/password-input', { id: 'resetPassword', name: 'newPassword', autocomplete: 'new-password', minlength: 8 }) %>
            <p class="form-hint"><%= t('auth.passwordHint') %></p>
          </div>
          <div class="form-group">
            <label for="resetConfirm"><%= t('forms.confirmPassword') %></label>
            <%- include('partials/password-input', { id: 'resetConfirm', name: 'confirmPassword', autocomplete: 'new-password' }) %>
          </div>
          <button type="submit" class="btn btn-primary btn-block"><%= t('reset.save') %></button>
        </form>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
