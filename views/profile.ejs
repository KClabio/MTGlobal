<%- include('partials/header', { title: t('profile.title') + ' - MTG' }) %>
<%
  const pState = typeof profileState !== 'undefined' && profileState ? profileState : {};
  const pwState = typeof passwordState !== 'undefined' && passwordState ? passwordState : {};
  // After a rejected submit, refill what the user typed; otherwise show the saved profile
  const v = typeof values !== 'undefined' && values ? values : user;
  const nameParts = (user.name || '').trim().split(/\s+/).filter(Boolean);
  const initials = ((nameParts[0] || '?')[0] + (nameParts.length > 1 ? nameParts[nameParts.length - 1][0] : '')).toUpperCase();
  const fromGoogle = !!user.googleId; // name, email and photo come from Google (routes/auth.js)
  const hasPassword = !!user.passwordHash;
  const dState = typeof deleteState !== 'undefined' && deleteState ? deleteState : {};
  const canDeleteSelf = user.role === 'customer'; // staff accounts are managed in Admin → Người dùng
  const memberSince = user.createdAt ? new Date(user.createdAt).toLocaleDateString(lang === 'en' ? 'en-US' : 'vi-VN', { month: 'long', year: 'numeric' }) : '';
%>

<section class="section">
  <div class="container profile-page">
    <h1 class="profile-heading"><%= t('profile.title') %></h1>

    <div class="profile-layout">
      <aside class="profile-summary">
        <% if (user.avatar) { %>
          <img class="avatar-lg" src="<%= resized(user.avatar, 320) %>" alt="<%= user.name %>">
        <% } else { %>
          <div class="avatar-lg avatar-fallback" aria-hidden="true"><%= initials %></div>
        <% } %>
        <h2 class="profile-name"><%= user.name %></h2>
        <p class="profile-email"><%= user.email %></p>
        <% if (fromGoogle) { %><p class="profile-google-linked" data-google-linked><%- include('partials/google-logo', { size: 14 }) %> <%= t('profile.googleLinked') %></p><% } %>
        <% if (memberSince) { %><p class="profile-meta"><%= t('profile.memberSince') %> <%= memberSince %></p><% } %>
        <%# Role: view only (changed by an owner in Admin → Người dùng); same badge as that list %>
        <div class="profile-bio profile-role">
          <h3><%= t('profile.role') %></h3>
          <span class="<%= { owner: 'tag role-owner', admin: 'tag role-admin', customer: 'tag' }[user.role] || 'tag' %>">
            <% if (user.role === 'owner') { %><%- include('admin/partials/icon', { name: 'crown', size: 13 }) %><% } %>
            <%= t('admin.roles.' + user.role) %>
          </span>
        </div>
        <div class="profile-bio">
          <h3><%= t('profile.bio') %></h3>
          <% if (user.bio) { %>
            <p class="bio-text"><%= user.bio %></p>
          <% } else { %>
            <p class="bio-text is-empty"><%= t('profile.bioEmpty') %></p>
          <% } %>
        </div>
      </aside>

      <div class="profile-forms">
        <div class="form-card">
          <h2 class="form-card-title"><%= t('profile.infoTitle') %></h2>
          <% if (pState.success) { %><div class="form-alert success"><%= pState.message || t('profile.updated') %></div><% } %>
          <% if (fromGoogle) { %><p class="profile-google-note" data-google-note><%- include('partials/google-logo', { size: 16 }) %><span><%= t('profile.googleNote') %></span></p><% } %>
          <% if (pState.error) { %><div class="form-alert error"><%= pState.error %></div><% } %>
          <form method="POST" action="/ho-so" enctype="multipart/form-data">
            <div class="form-group">
              <label for="pf-avatar"><%= t('profile.avatar') %></label>
              <div class="avatar-picker">
                <% if (user.avatar) { %>
                  <img class="avatar-sm" src="<%= user.avatar %>" alt="" data-avatar-preview>
                <% } else { %>
                  <div class="avatar-sm avatar-fallback" data-avatar-preview><%= initials %></div>
                <% } %>
                <div>
                  <div class="avatar-actions">
                    <label class="btn btn-ghost btn-sm avatar-choose">
                      <%= t('profile.chooseAvatar') %>
                      <input type="file" id="pf-avatar" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" data-avatar-input data-max-bytes="<%= avatarMaxBytes %>" data-size-error="<%= t('profile.errAvatarSize') %>" hidden>
                    </label>
                    <%# A photo chosen but not saved yet: drop it again (main.js) %>
                    <button type="button" class="btn btn-ghost btn-sm avatar-drop" data-avatar-drop hidden><%= t('profile.dropChosen') %></button>
                    <%# Only for an own or Google photo, not for the two letters; its own form below (forms can't nest) %>
                    <% if (user.avatar) { %>
                      <button type="submit" form="avatar-remove" class="btn btn-ghost btn-sm btn-danger-ghost" data-avatar-delete>
                        <%- include('admin/partials/icon', { name: 'trash', size: 14 }) %> <%= t('profile.deleteAvatar') %>
                      </button>
                    <% } %>
                  </div>
                  <p class="form-hint"><%= t('profile.avatarHint') %></p>
                </div>
              </div>
            </div>
            <div class="form-group">
              <label for="pf-name"><%= t('forms.name') %> *</label>
              <% if (fromGoogle) { %>
                <input class="form-control" type="text" id="pf-name" value="<%= user.name %>" readonly aria-describedby="nameFromGoogle" data-google-name>
                <p class="form-hint" id="nameFromGoogle"><%= t('profile.googleNameLocked') %></p>
              <% } else { %>
                <input class="form-control" type="text" id="pf-name" name="name" value="<%= v.name || '' %>" required autocomplete="name">
              <% } %>
            </div>
            <div class="form-group">
              <label for="pf-email"><%= t('forms.email') %></label>
              <input class="form-control" type="email" id="pf-email" value="<%= user.email %>" disabled>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="pf-phone"><%= t('forms.phone') %></label>
                <input class="form-control" type="tel" id="pf-phone" name="phone" value="<%= v.phone || '' %>" autocomplete="tel">
              </div>
              <div class="form-group">
                <label for="pf-school"><%= t('forms.schoolOrCompany') %></label>
                <input class="form-control" type="text" id="pf-school" name="schoolOrCompany" value="<%= v.schoolOrCompany || '' %>" autocomplete="organization">
              </div>
            </div>
            <div class="form-group">
              <label for="pf-bio"><%= t('profile.bio') %></label>
              <textarea class="form-control" id="pf-bio" name="bio" rows="4" maxlength="500" placeholder="<%= t('profile.bioPlaceholder') %>" data-count="bioCount"><%= v.bio || '' %></textarea>
              <div class="char-count"><span id="bioCount"><%= (v.bio || '').length %></span>/500</div>
            </div>
            <button type="submit" class="btn btn-primary btn-block"><%= t('common.update') %></button>
          </form>
          <% if (user.avatar) { %>
            <form id="avatar-remove" method="POST" action="/ho-so/anh-dai-dien/xoa" data-avatar-remove-form></form>
            <dialog class="profile-confirm" data-avatar-confirm aria-labelledby="avatarConfirmTitle">
              <h3 id="avatarConfirmTitle"><%= t('profile.deleteAvatarTitle') %></h3>
              <p><%= t('profile.deleteAvatarText') %></p>
              <% if (fromGoogle && user.avatarMode !== 'own') { %><p class="form-hint"><%= t('profile.deleteAvatarGoogle') %></p><% } %>
              <div class="profile-confirm-actions">
                <button type="button" class="btn btn-ghost" data-confirm-cancel><%= t('common.cancel') %></button>
                <button type="button" class="btn btn-danger" data-confirm-ok><%- include('admin/partials/icon', { name: 'trash', size: 15 }) %> <%= t('profile.deleteAvatar') %></button>
              </div>
            </dialog>
          <% } %>
        </div>

        <div class="form-card">
          <h2 class="form-card-title"><%= t(hasPassword ? 'profile.passwordTitle' : 'profile.setPasswordTitle') %></h2>
          <% if (pwState.success) { %><div class="form-alert success"><%= pwState.message || t('profile.passwordChanged') %></div><% } %>
          <% if (!hasPassword) { %><p class="form-hint" style="margin:0 0 16px;" data-set-password><%= t('profile.setPasswordIntro') %></p><% } %>
          <% if (pwState.error) { %><div class="form-alert error"><%= pwState.error %></div><% } %>
          <form method="POST" action="/ho-so/mat-khau">
            <%# Not sent (no name): tells the browser whose saved password to offer for "Mật khẩu hiện tại". The real password is never stored readably, so the site itself cannot fill it. %>
            <input type="email" class="sr-only" autocomplete="username" value="<%= user.email %>" tabindex="-1" aria-hidden="true" readonly>
            <%# A Google account without a password sets its first one: nothing to type as "current" %>
            <% if (hasPassword) { %>
              <div class="form-group">
                <label for="currentPassword"><%= t('profile.currentPassword') %></label>
                <%- include('partials/password-input', { id: 'currentPassword', name: 'currentPassword', autocomplete: 'current-password' }) %>
              </div>
            <% } %>
            <div class="form-row">
              <div class="form-group">
                <label for="newPassword"><%= t('profile.newPassword') %></label>
                <%- include('partials/password-input', { id: 'newPassword', name: 'newPassword', autocomplete: 'new-password', minlength: 6 }) %>
              </div>
              <div class="form-group">
                <label for="confirmNewPassword"><%= t('profile.confirmNewPassword') %></label>
                <%- include('partials/password-input', { id: 'confirmNewPassword', name: 'confirmPassword', autocomplete: 'new-password', minlength: 6 }) %>
              </div>
            </div>
            <p class="form-hint" style="margin:-8px 0 18px;"><%= t('profile.passwordHint') %></p>
            <button type="submit" class="btn btn-primary btn-block"><%= t(hasPassword ? 'profile.changePassword' : 'profile.setPassword') %></button>
          </form>
        </div>

        <%# "Dữ liệu của bạn" (Decree 13): a copy of everything stored, and deleting the account (routes/auth.js) %>
        <div class="form-card profile-data-card" data-privacy-card>
          <h2 class="form-card-title"><%= t('privacy.dataTitle') %></h2>
          <p class="form-hint profile-data-hint" data-privacy-hint><%= t('privacy.dataText') %> <a href="/chinh-sach-bao-mat"><%= t('privacy.title') %></a>.</p>
          <% if (dState.error) { %><div class="form-alert error" data-delete-error><%= dState.error %></div><% } %>
          <div class="profile-data-actions">
            <a class="btn btn-ghost" href="/ho-so/du-lieu" download data-data-download><%- include('admin/partials/icon', { name: 'download', size: 16 }) %> <%= t('privacy.download') %></a>
            <% if (canDeleteSelf) { %>
              <button type="button" class="btn btn-ghost btn-danger-ghost" data-account-delete aria-haspopup="dialog"><%- include('admin/partials/icon', { name: 'trash', size: 16 }) %> <%= t('privacy.deleteAccount') %></button>
            <% } %>
          </div>
          <% if (!canDeleteSelf) { %><p class="form-hint" data-staff-no-delete><%= t('privacy.staffNoDelete') %></p><% } %>
          <% if (canDeleteSelf) { %>
            <dialog class="profile-confirm account-confirm" data-account-confirm aria-labelledby="accountConfirmTitle"<%= dState.error ? ' data-open-now' : '' %>>
              <form method="POST" action="/ho-so/xoa-tai-khoan" data-account-delete-form>
                <h3 id="accountConfirmTitle"><%= t('privacy.deleteTitle') %></h3>
                <p><%= t('privacy.deleteText') %></p>
                <div class="form-group">
                  <label for="deleteConfirm"><%= t(hasPassword ? 'privacy.deleteConfirmPassword' : 'privacy.deleteConfirmEmail') %></label>
                  <% if (hasPassword) { %>
                    <%- include('partials/password-input', { id: 'deleteConfirm', name: 'confirm', autocomplete: 'current-password', invalid: !!dState.error }) %>
                  <% } else { %>
                    <input class="form-control<%= dState.error ? ' is-invalid' : '' %>" type="email" id="deleteConfirm" name="confirm" required autocomplete="off" spellcheck="false" placeholder="<%= user.email %>">
                  <% } %>
                  <% if (dState.error) { %><div class="field-error"><%= dState.error %></div><% } %>
                </div>
                <div class="profile-confirm-actions">
                  <button type="button" class="btn btn-ghost" data-confirm-cancel><%= t('common.cancel') %></button>
                  <button type="submit" class="btn btn-danger" data-confirm-ok><%- include('admin/partials/icon', { name: 'trash', size: 15 }) %> <%= t('privacy.deleteAccount') %></button>
                </div>
              </form>
            </dialog>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
