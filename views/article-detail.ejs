<%- include('partials/header', { title: article.titleVi + ' - MTG', description: pick(article, 'body'), image: article.coverImage, ogType: 'article', bannerKey: 'news' }) %>

<%- include('partials/page-banner', {
  pill: t('nav.news'),
  heading: article.titleVi,
  subheading: new Date(article.createdAt).toLocaleDateString(lang === 'en' ? 'en-US' : 'vi-VN'),
  backHref: '/tin-tuc',
  bannerKey: 'news'
}) %>

<section class="section">
  <div class="container" style="max-width:760px;">
    <% if (article.coverImage) { %>
      <div class="card-media" style="border-radius:var(--mtg-radius); margin-bottom:24px; aspect-ratio:16/9;">
        <%- picture(article.coverImage, article.titleVi, { sizes: '(max-width: 900px) 100vw, 640px', eager: true }) %>
      </div>
    <% } %>
    <div class="prose-text"><%- formatText(pick(article, 'body')) %></div>
  </div>
</section>

<%- include('partials/footer') %>
