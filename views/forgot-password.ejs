<%- include('partials/header', { title: t('reset.forgotTitle') + ' - MTG', noindex: true }) %>

<section class="section">
  <div class="container" style="max-width:480px;">
    <h1 style="text-align:center;"><%= t('reset.forgotTitle') %></h1>
    <div class="form-card">
      <% if (!available) { %>
        <%# No email account on this server: the link can't be sent, so the page says whom to ask %>
        <p data-reset-off><%= t('reset.off') %></p>
        <% const resetContact = (settings && settings.contactInfo) || {}; %>
        <% const resetPhones = phoneList(resetContact.phone); %>
        <% if (resetPhones.length) { %><p><% resetPhones.forEach(function (p, i) { %><%= i ? ' - ' : '' %><a href="tel:<%= p.tel %>"><%= p.text %></a><% }) %></p><% } %>
        <% if (resetContact.email) { %><p><a href="mailto:<%= resetContact.email %>"><%= resetContact.email %></a></p><% } %>
      <% } else if (sent) { %>
        <div class="form-alert success" role="status" data-reset-sent><%= t('reset.sent', { minutes: minutes }) %></div>
        <p class="form-hint"><%= t('reset.sentHint') %></p>
      <% } else { %>
        <p><%= t('reset.forgotIntro') %></p>
        <% if (error) { %><div class="form-alert error"><%= error %></div><% } %>
        <form method="POST" action="/quen-mat-khau">
          <div class="form-group">
            <label for="forgotEmail"><%= t('forms.email') %></label>
            <input class="form-control" type="email" id="forgotEmail" name="email" required autocomplete="username" value="<%= email %>">
          </div>
          <button type="submit" class="btn btn-primary btn-block"><%= t('reset.send') %></button>
        </form>
      <% } %>
      <p class="auth-switch"><a href="/dang-nhap"><%= t('reset.backToLogin') %></a></p>
      <%- include('partials/help-link', { text: t('help.loginHelp'), anchor: 'tai-khoan' }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
