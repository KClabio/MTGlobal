<%- include('partials/header', {
  title: (lang === 'en' ? 'About MTG' : 'Về MTG') + ' - MTG',
  description: settings && (lang === 'en' && settings.companyProfileEn ? settings.companyProfileEn : settings.companyProfile),
}) %>

<%- include('partials/page-banner', {
  pill: 'MTG',
  heading: lang === 'en' ? 'About Mễ Trì Global Technology Co., Ltd' : 'Về Công ty TNHH Công nghệ Mễ Trì Global',
  bannerKey: 'about'
}) %>

<section class="section">
  <div class="container">
    <% if (settings && settings.contactInfo && settings.contactInfo.address) { %>
      <p style="text-align:center; max-width:640px; margin:0 auto 2em;">
        <strong><%= t('common.address') %>:</strong> <%= settings.contactInfo.address %>
        <% if (settings.contactInfo.taxCode) { %><br><span data-about-tax><strong><%= t('footer.taxCode') %>:</strong> <%= settings.contactInfo.taxCode %><% if (settings.contactInfo.registration) { %>, <%= settings.contactInfo.registration %><% } %></span><% } %>
      </p>
    <% } else if (settings && settings.contactInfo && settings.contactInfo.taxCode) { %>
      <p style="text-align:center; max-width:640px; margin:0 auto 2em;" data-about-tax>
        <strong><%= t('footer.taxCode') %>:</strong> <%= settings.contactInfo.taxCode %><% if (settings.contactInfo.registration) { %>, <%= settings.contactInfo.registration %><% } %>
      </p>
    <% } %>
    <% const companyProfile = settings && (lang === 'en' && settings.companyProfileEn ? settings.companyProfileEn : settings.companyProfile); %>
    <% if (companyProfile) { %>
      <div class="prose-text"><%- formatText(companyProfile) %></div>
    <% } %>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title"><%= lang === 'en' ? 'Three Business Pillars' : 'Ba lĩnh vực hoạt động' %></h2>
    </div>
    <div class="pillar-grid">
      <div class="pillar-card c-products">
        <h3><%= lang === 'en' ? '1. Products — Smart Robotics' : '1. Sản phẩm – Robotics thông minh' %></h3>
        <%# The robots of Admin → Robot, in its order, each linked to its page; "Sắp ra mắt" ones are marked %>
        <ul data-about-robots>
          <% (typeof robots !== 'undefined' ? robots : []).forEach(function (r) {
               const rName = (lang === 'en' && r.nameEn) ? r.nameEn : (r.nameVi || r.nameEn); %>
            <li><a href="/san-pham/<%= r.category %>"><%= rName %></a><% if (r.comingSoon) { %> <span class="tag about-robot-soon"><%= t('common.comingSoon') %></span><% } %></li>
          <% }) %>
          <% if (typeof robots === 'undefined' || !robots.length) { %><li><a href="/san-pham"><%= t('nav.products') %></a></li><% } %>
        </ul>
      </div>
      <div class="pillar-card c-solution">
        <h3><%= lang === 'en' ? '2. Solution — STEM Lab for every education level' : '2. Giải pháp: Phòng Lab STEM cho mọi cấp học' %></h3>
        <ul>
          <li><%= lang === 'en' ? 'Consulting, design and deployment of STEM Labs' : 'Tư vấn, thiết kế và triển khai STEM Lab' %></li>
          <li><%= lang === 'en' ? 'Supply of STEM equipment/components: robotics, CNC, 3D printing, parts & accessories' : 'Cung cấp thiết bị/linh kiện STEM: Robotics, Máy công cụ CNC, 3D, Bộ phụ kiện, linh kiện/vật tư' %></li>
          <li><%= lang === 'en' ? 'STEM experience models' : 'Cung cấp các mô hình về trải nghiệm STEM' %></li>
        </ul>
      </div>
      <div class="pillar-card c-services">
        <h3><%= lang === 'en' ? '3. Services' : '3. Dịch vụ' %></h3>
        <ul>
          <li><%= lang === 'en' ? 'Study-abroad consulting' : 'Tư vấn du học' %></li>
          <li><%= lang === 'en' ? 'Distribution & commercialization of technology products' : 'Phân phối và thương mại hóa sản phẩm công nghệ' %></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<% if (partners && partners.length) { %>
<section class="section" id="doi-tac">
  <div class="container">
    <%- include('partials/partner-slider', { partners }) %>
  </div>
</section>
<% } %>

<%# Văn phòng MTG: the address and contacts of Thông tin công ty beside a Google map. The map is the one pasted in
    Admin → Thông tin công ty → Bản đồ, else Google's map of the address (lib/map-embed.js mapFor); no address, no
    section. The map loads only when scrolled near (loading="lazy"); printing shows the address without it. %>
<% const abContact = (settings && settings.contactInfo) || {}; const abMap = mapFor(abContact, lang); %>
<% if (abMap) { %>
<% const abPhones = phoneList(abContact.phone); %>
<section class="section section-alt" id="ban-do">
  <div class="container about-visit">
    <div class="about-visit-text">
      <h2 class="section-title"><%= t('common.visitTitle') %></h2>
      <% if (abContact.address) { %><p class="about-visit-address" data-about-address><%= abContact.address %></p><% } %>
      <% if (abPhones.length) { %><p><%= t('common.phone') %>: <% abPhones.forEach(function (p, i) { %><%= i ? ' - ' : '' %><a href="tel:<%= p.tel %>"><%= p.text %></a><% }) %></p><% } %>
      <% if (abContact.email) { %><p><%= t('common.email') %>: <a href="mailto:<%= abContact.email %>"><%= abContact.email %></a></p><% } %>
      <% const abDirections = directionsUrl(abContact.address); %>
      <% if (abDirections) { %><a class="btn btn-ghost btn-sm about-visit-open" href="<%= abDirections %>" target="_blank" rel="noopener" data-about-directions><%= t('common.openInMaps') %> ↗<span class="sr-only"> <%= t('common.openInMapsNewTab') %></span></a><% } %>
    </div>
    <div class="contact-map about-visit-map" data-about-map data-map-hint="<%= t('common.mapUse') %>">
      <iframe src="<%= abMap %>" title="<%= t('common.mapTitle', { address: (abContact.address || 'MTG') }) %>" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
