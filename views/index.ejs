<%- include('partials/header', { title: 'MTG - Smart Solutions for Life' }) %>

<section class="home-hero">
  <div class="container home-hero-inner">
    <div>
      <span class="hero-pill">MTG — Mễ Trì Global</span>
      <%
        // Admin → Cài đặt chung → Trang chủ: optional text overrides (empty = the default text)
        const hh = (settings && settings.homeHero) || {};
        const hhTitle = ((lang === 'en' ? hh.titleEn : hh.titleVi) || '').trim();
        const hhSub = ((lang === 'en' ? hh.subtitleEn : hh.subtitleVi) || '').trim();
      %>
      <h1><%= hhTitle || t('home.heroTitle') %></h1>
      <p><%= hhSub || t('home.heroSubtitle') %></p>
      <a href="/lien-he" class="btn btn-primary"><%= t('home.heroCta') %></a>
    </div>
    <div class="home-hero-art">
      <% if (settings && settings.heroImages && settings.heroImages.home) { %>
        <%- picture(settings.heroImages.home, 'MTG', { sizes: '(max-width: 900px) 100vw, 560px', eager: true }) %>
      <% } %>
    </div>
  </div>
</section>

<%# Business areas (lib/home-domains.js): a horizontal slider — 3½ cards in view, the mouse wheel scrolls it sideways (public/js/main.js).
    Card links carry ?from=home so the opened page shows "← Về trang chủ" (views/partials/page-banner.ejs). %>
<section class="section domains-section" id="linh-vuc">
  <div class="container">
    <div class="section-head domains-head">
      <h2 class="section-title"><%= t('home.pillarsTitle') %></h2>
      <div class="domain-arrows">
        <button type="button" class="domain-arrow" data-domain-prev aria-label="<%= t('home.domainsPrev') %>" title="<%= t('home.domainsPrev') %>" disabled>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" class="domain-arrow" data-domain-next aria-label="<%= t('home.domainsNext') %>" title="<%= t('home.domainsNext') %>">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>
    <ul class="domain-track" data-domain-slider tabindex="0" role="region" aria-label="<%= t('home.pillarsTitle') %>">
      <% domains.forEach(function (d) { %>
        <li class="domain-item">
          <a class="domain-card accent-<%= d.accent %>" href="<%= d.url %>?from=home">
            <div class="domain-media<%= d.contain ? ' is-contain' : '' %><%= d.image ? '' : ' is-art' %>">
              <% if (d.image) { %>
                <%- picture(d.image, '', { sizes: '(max-width: 640px) 80vw, 300px', attrs: 'draggable="false"' }) %>
              <% } else { %>
                <%- include('admin/partials/icon', { name: d.icon, size: 64 }) %>
              <% } %>
            </div>
            <div class="domain-body">
              <span class="domain-icon"><%- include('admin/partials/icon', { name: d.icon, size: 20 }) %></span>
              <h3><%= d.title %></h3>
              <% if (d.text) { %><p><%= d.text %></p><% } %>
              <span class="domain-link"><%= t('common.learnMore') %> →</span>
            </div>
          </a>
        </li>
      <% }) %>
    </ul>
  </div>
</section>

<% if (robots && robots.length) { %>
<section class="section section-alt">
  <div class="container">
    <div class="section-head"><h2 class="section-title"><%= t('nav.products') %></h2></div>
    <div class="card-grid cols-4">
      <% robots.forEach(function (product) { %>
        <%- include('partials/product-card', { product }) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (featuredProjects && featuredProjects.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head"><h2 class="section-title"><%= t('home.featuredProjectsTitle') %></h2></div>
    <div class="card-grid">
      <% featuredProjects.forEach(function (project) { %>
        <%- include('partials/project-card', { project }) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section section-alt">
  <div class="container">
    <div class="section-head"><h2 class="section-title"><%= t('home.partnersTitle') %></h2></div>
    <% if (partners && partners.length) { %>
      <div class="partner-strip">
        <% partners.forEach(function (partner) { %><%- include('partials/partner-tile', { partner }) %><% }) %>
      </div>
    <% } else { %>
      <p class="empty-note"><%= lang === 'en' ? 'Partner logos coming soon.' : 'Danh sách đối tác đang được cập nhật.' %></p>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
