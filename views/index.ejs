<%- include('partials/header', {
  title: 'MTG - Smart Solutions for Life',
  description: ((settings && settings.homeHero && (lang === 'en' ? settings.homeHero.subtitleEn : settings.homeHero.subtitleVi)) || '').trim() || t('home.heroSubtitle'),
  image: heroImage,
  homeHero: true,
}) %>

<%# The photo fills the section behind the text: the uploaded picture (Cài đặt chung → Trang chủ), else the built-in
    photo (lib/home-domains.js homeHeroImage). A dark veil (home.css) keeps the text readable over any photo. %>
<section class="home-hero">
  <div class="home-hero-art"><%- picture(heroImage, heroBuiltIn ? t('home.heroImageAlt') : 'MTG', { sizes: '100vw', eager: true }) %></div>
  <div class="container home-hero-inner">
    <div class="home-hero-text">
      <span class="hero-pill">MTG — Mễ Trì Global</span>
      <%
        // Admin → Cài đặt chung → Trang chủ: optional text overrides (empty = the default text)
        const hh = (settings && settings.homeHero) || {};
        const hhTitle = ((lang === 'en' ? hh.titleEn : hh.titleVi) || '').trim();
        const hhSub = ((lang === 'en' ? hh.subtitleEn : hh.subtitleVi) || '').trim();
      %>
      <h1><%= hhTitle || t('home.heroTitle') %></h1>
      <p><%= hhSub || t('home.heroSubtitle') %></p>
      <a href="/lien-he" class="btn btn-primary"><%= t('home.heroCta') %></a>
    </div>
    <%# Key figures (routes/index.js heroFigures): the real number is in the HTML; public/js/main.js counts the visible
        digits up from 0 once. Screen readers get the sr-only sentence, never the moving digits. %>
    <% if (heroFigures && heroFigures.length) { %>
      <% const figDigits = Math.max.apply(null, heroFigures.map(function (f) { return String(f.n).length; })); /* one width for every number: the labels line up */ %>
      <ul class="home-hero-figures" data-hero-figures aria-label="<%= t('home.figuresLabel') %>">
        <% heroFigures.forEach(function (f, i) { %>
          <li class="fig accent-<%= f.accent %>" style="--fig-i: <%= i %>">
            <a href="<%= f.href %>">
              <span class="fig-icon" aria-hidden="true"><%- include('admin/partials/icon', { name: f.icon, size: 20 }) %></span>
              <span class="fig-num" data-fig-count="<%= f.n %>" style="min-width: calc(<%= figDigits %>ch + .1em)" aria-hidden="true"><%= f.n %></span>
              <span class="fig-text" aria-hidden="true"><span class="fig-label"><%= t('home.fig.' + f.key) %></span><span class="fig-sub"><%= t('home.fig.' + f.key + 'Sub') %></span></span>
              <span class="fig-arrow" aria-hidden="true">→</span>
              <span class="sr-only"><%= f.n %> <%= t('home.fig.' + f.key) %> <%= t('home.fig.' + f.key + 'Sub') %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</section>

<%# Business areas (lib/home-domains.js): 3½ cards in view, sliding slowly to the right by themselves and looping, like the partner
    row below (public/js/main.js loopRow: stops under the mouse, ‹ › and the mouse wheel move one card). Without JavaScript: a row to scroll sideways.
    Card links carry ?from=home so the opened page shows "← Về trang chủ" (views/partials/page-banner.ejs). %>
<section class="section domains-section" id="linh-vuc">
  <div class="container">
    <div class="section-head domains-head">
      <h2 class="section-title"><%= t('home.pillarsTitle') %></h2>
      <div class="domain-arrows" data-domain-arrows>
        <button type="button" class="domain-arrow" data-domain-prev aria-label="<%= t('home.domainsPrev') %>" title="<%= t('home.domainsPrev') %>">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" class="domain-arrow" data-domain-next aria-label="<%= t('home.domainsNext') %>" title="<%= t('home.domainsNext') %>">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>
    <%# A named list (no role): screen readers say "Lĩnh vực hoạt động, list, 7 items" (the copies made for the loop are hidden from them);
        tabindex: with the list focused, ← / → move one card %>
    <div class="domain-marquee" data-domain-marquee>
    <ul class="domain-track" data-domain-slider tabindex="0" aria-label="<%= t('home.pillarsTitle') %>">
      <% domains.forEach(function (d) { %>
        <li class="domain-item">
          <a class="domain-card accent-<%= d.accent %>" href="<%= d.url %>?from=home">
            <div class="domain-media<%= d.contain ? ' is-contain' : '' %><%= d.image ? '' : ' is-art' %>">
              <% if (d.image) { %>
                <%- picture(d.image, '', { sizes: '(max-width: 640px) 80vw, 300px', attrs: 'draggable="false"' }) %>
              <% } else { %>
                <%- include('admin/partials/icon', { name: d.icon, size: 64 }) %>
              <% } %>
            </div>
            <div class="domain-body">
              <span class="domain-icon"><%- include('admin/partials/icon', { name: d.icon, size: 20 }) %></span>
              <h3><%= d.title %></h3>
              <% if (d.text) { %><p><%= d.text %></p><% } %>
              <span class="domain-link"><%= t('common.learnMore') %> →</span>
            </div>
          </a>
        </li>
      <% }) %>
    </ul>
    </div>
  </div>
</section>

<% if (robots && robots.length) { %>
<section class="section section-alt">
  <div class="container">
    <div class="section-head"><h2 class="section-title"><%= t('nav.products') %></h2></div>
    <div class="card-grid cols-4">
      <% robots.forEach(function (product) { %>
        <%- include('partials/product-card', { product }) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (featuredProjects && featuredProjects.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head"><h2 class="section-title"><%= t('home.featuredProjectsTitle') %></h2></div>
    <div class="card-grid">
      <% featuredProjects.forEach(function (project) { %>
        <%- include('partials/project-card', { project }) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%# Partners: the sliding row (partials/partner-slider.ejs, the same on Về MTG) %>
<section class="section section-alt" id="doi-tac">
  <div class="container">
    <%- include('partials/partner-slider', { partners }) %>
  </div>
</section>

<%- include('partials/footer') %>
